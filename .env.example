# Frontend (apps/web) → sector-service
# Browser-side fetches go through the /api/sim Next.js rewrite (see
# apps/web/next.config.ts), which itself uses SECTOR_SERVICE_URL as the
# upstream, so no NEXT_PUBLIC_* var is needed.
#
# Leave unset on the host so Node falls back to http://localhost:8001. In
# Docker Compose the web service overrides this to the internal hostname
# (http://sector-service:8001).
# SECTOR_SERVICE_URL=http://sector-service:8001

# Postgres (packages/db / docker-compose `postgres` service).
# Host-side Prisma (migrate / seed / studio) connects via the host port
# mapped in docker-compose.local.yml (6543 by default, to avoid colliding
# with any system postgresql on 5432). In-cluster services use
# postgres:5432 — container-internal port is unchanged.
DATABASE_URL=postgresql://platform:platform@localhost:6543/platform_dev

# Used only inside docker-compose to initialize the postgres container —
# these match the defaults in DATABASE_URL above. Override all three
# together if you change credentials.
POSTGRES_USER=platform
POSTGRES_PASSWORD=platform
POSTGRES_DB=platform_dev

# Demo seed gate for the `db-migrate` + `graph-bootstrap` one-shot
# containers in docker-compose. Default `on` — runs `prisma migrate`
# then seeds the 4 reference sectors, capabilities, actors, equities,
# graph nodes/edges. Set to `off` to boot an empty DB (only the schema)
# so you can test ingest from scratch via Vision Builder. `migrate:deploy`
# always runs regardless — schema is mandatory.
# SEED_DATA=off

# services/sector-service (Fastify + tRPC) — upstream simulation-service.
# Inside docker-compose this is wired automatically; only needed here when
# running sector-service from the host (pnpm --filter @platform/sector-service dev).
# SIMULATION_SERVICE_URL=http://localhost:8000

# Agent orchestration + prediction.analyzeRationale
#
# ─── Vertex AI (F9 — Gemini-only) ─────────────────────────────────────
# Drop a service-account JSON key at infra/secrets/vertex-ai-sa.json
# (see infra/secrets/README.md for setup). The SA authenticates every
# tier through google-genai (Vertex AI Gemini). `project_id` is read
# from the SA JSON itself when GOOGLE_CLOUD_PROJECT is left blank.
#
# These values are injected into the containers via `env_file:` in
# docker-compose.yml (NOT via `${VAR:-default}` interpolation), so a
# stray `export GOOGLE_CLOUD_LOCATION=...` in your shell can NOT
# override them — only this file can.
GOOGLE_GENAI_USE_VERTEXAI=true
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global
# Note: GOOGLE_APPLICATION_CREDENTIALS is hard-pinned in docker-compose.yml
# to /secrets/vertex-ai-sa.json (the in-container mount). Setting it
# here has no effect on the containerized services. Override only when
# running services from the host (`pnpm dev` outside Docker).
GOOGLE_APPLICATION_CREDENTIALS=/secrets/vertex-ai-sa.json
#
# ─── API-key fallback (dev + grounded research) ──────────────────────
# Get a Gemini key at https://aistudio.google.com/apikey. Two roles:
# (1) AI Studio fallback for the agent-orchestration LLMClient when
#     Vertex isn't configured;
# (2) Grounded research client (data-pipeline) accepts this when
#     GOOGLE_GENAI_USE_VERTEXAI is not set.
# Post-F9 every tier is Gemini, so this one key unblocks the whole
# agent surface in dev.
# GEMINI_API_KEY=

# ─── LLM model overrides (env-driven, env > built-in default) ────────
# llm_client.py picks a model per semantic tier (depth/cost trade-off);
# the grounded-research client (data-pipeline fetchers + daily digest)
# shares the same env vars, so what you set here applies to BOTH agent
# calls AND grounded research. No separate GROUNDED_MODEL_* vars —
# they were unified in slice 11. Defaults:
#   deep      → gemini-3.1-pro-preview    (VisionDecomposition / CodeReview / digest)
#   balanced  → gemini-3.5-flash          (VisionResearch / DataSourceSelector / ThesisDrafter)
#   fast      → gemini-3.1-flash-lite     (SignalExtractor / PromptValidator /
#                                          capability/actor/risk/signal fetchers)
# ⚠ Pre-F9b LLM_{OPUS,SONNET,HAIKU}_MODEL env vars are silently
# ignored. ⚠ Pre-unification GROUNDED_MODEL_FAST / GROUNDED_MODEL_DEEP
# are silently ignored too (a startup warning fires when either is
# still set).
# LLM_DEEP_MODEL=
# LLM_BALANCED_MODEL=
# LLM_FAST_MODEL=

# ─── services/data-pipeline — ARQ queue broker ───────────────────────
# All on-demand fetcher triggers (capability / actor / risk / signal /
# digest / hello-world) and the M49f orchestrator dispatcher push jobs
# onto an ARQ (async Redis queue) — the data-pipeline HTTP layer only
# enqueues; the `data-pipeline-worker` container drains the queue and
# runs the actual grounded-gemini work. Compose ships a `redis` service;
# only override if you're running data-pipeline from the host.
# REDIS_URL=redis://redis:6379/0

# ─── services/data-pipeline — quote ingest ───────────────────────────
# `yfinance` (default) or `fake` for offline smoke tests.
# INGEST_SOURCE=yfinance

# Daily quote refresh cron (UTC). Default 08:30 UTC = 17:30 KST.
# INGEST_CRON_QUOTES=30 8 * * *

# Set to `off` to disable the APScheduler entirely (manual /jobs/*
# triggers still work).
# INGEST_SCHEDULE=on

# ─── services/data-pipeline — tiered signal ingest ───────────────────
# 5-min news_ingest sweep — crawl4ai over Yahoo Finance + Naver
# Finance + Finviz news lists (per-vision ticker map in
# data_pipeline/signals/tickers.py). No API key — the adapters scrape
# the public list pages, extract markdown bodies, and hand them to
# the SignalExtractor agent. Container build runs
# `playwright install --with-deps chromium` once for the JS-rendered
# Yahoo pages; nothing for the operator to set up at runtime.
#
# Toggle: NEWS_INGEST_SCHEDULE=off to disable the 5-min cron (manual
# /jobs/signal-ingest still works).
# NEWS_INGEST_SCHEDULE=on

# Hourly research_ingest (arXiv + USPTO). Default armed. USPTO calls
# work without a key for the public bulk endpoints; set USPTO_API_KEY
# only if you start hitting their rate ceiling.
# RESEARCH_INGEST_SCHEDULE=on
# USPTO_API_KEY=
#
# Lookback window for arXiv `submittedDate` filter. Default 7 days
# (was 3) — low-publication-rate fields (fusion, sofc) often have
# zero matches in 3 days. Widen to backfill historical runs.
# RESEARCH_INGEST_LOOKBACK_DAYS=7

# M49f opportunistic orchestrator picker (15-min). Default off so dev
# doesn't burn LLM budget. CRAWLER_SCHEDULE accepted as a legacy alias.
# ORCHESTRATOR_SCHEDULE=off

# Daily grounded-research digest (one per vision). DEEP-tier model
# (~$0.30/call) × number of visions per day. Default off so operators
# turn it on only after validating prompt + cost in the cockpit.
# DIGEST_SCHEDULE=off
# DIGEST_CRON=0 6 * * *

# ─── data-pipeline — cron cadence overrides (local testing) ──────────
# These let you tighten the schedule on a dev machine so every job
# fires within a minute instead of waiting on its real cadence. Don't
# ship these to prod — they will hammer your LLM budget. Combine with
# INGEST_SCHEDULE=on (and the per-job *_SCHEDULE flags above) to
# actually arm.
#
# ⚠ Spelling is exact + case-sensitive. A typo (e.g.,
# `iNEWS_INGEST_INTERVAL_MIN=1`) silently no-ops — the value just falls
# back to the built-in default and your cron keeps firing on its
# original cadence. If a job isn't behaving the way the env says it
# should, double-check the var name letter-for-letter.
#
#   NEWS_INGEST_INTERVAL_MIN     — default 5
#   RESEARCH_INGEST_CRON         — default "7 * * * *"
#   RECOMPUTE_FEASIBILITY_CRON   — default "25 * * * *"
#   ORCHESTRATOR_INTERVAL_MIN    — default 15 (needs ORCHESTRATOR_SCHEDULE=on)
#   DIGEST_CRON                  — already documented above
#   RESOLVE_PREDICTIONS_V2_CRON  — default "5 * * * *"
#   INGEST_CRON_QUOTES           — already documented above
#
# Example block for "fire everything every minute" testing:
#   INGEST_SCHEDULE=on
#   ORCHESTRATOR_SCHEDULE=on
#   DIGEST_SCHEDULE=on
#   NEWS_INGEST_INTERVAL_MIN=1
#   RESEARCH_INGEST_CRON=* * * * *
#   RECOMPUTE_FEASIBILITY_CRON=* * * * *
#   ORCHESTRATOR_INTERVAL_MIN=1
#   DIGEST_CRON=* * * * *
#   RESOLVE_PREDICTIONS_V2_CRON=* * * * *
#   INGEST_CRON_QUOTES=* * * * *

# ─── Admin (SQLAdmin at data-pipeline /admin + apps/admin legacy) ────
# The data-pipeline SQLAdmin surface at http://localhost:8003/admin and
# the legacy Next.js admin (port 3100) both read the same single
# env-driven account. Without all three set, every protected route
# redirects to /login with a "not configured" notice; no silent bypass.
# Session cookies are signed with ADMIN_SESSION_SECRET (HMAC-SHA256, 7d).
#
# Rotate the secret to invalidate all sessions immediately.
# Use a 32+ char random string — e.g. `openssl rand -hex 32`.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-before-shipping
ADMIN_SESSION_SECRET=replace-with-openssl-rand-hex-32

# Set to `https` when the data-pipeline runs behind a TLS-terminating
# proxy that does NOT forward X-Forwarded-Proto — e.g., Google Cloud
# Workstation's *.proxy.googlers.com. Without it, SQLAdmin renders
# http:// static URLs on an https:// page and the browser blocks
# everything as Mixed Content (admin shows up as unstyled HTML).
# Leave unset for plain http://localhost dev or environments where the
# upstream X-Forwarded-Proto header is trustworthy.
# ADMIN_FORCE_URL_SCHEME=https

# Timezone every visible admin timestamp is rendered in (custom Jinja
# pages + SQLAdmin's auto-rendered datetime columns). Defaults to
# Asia/Seoul (KST) since the current operator is in Korea. Set to any
# IANA tz name (e.g., `UTC`, `America/Los_Angeles`, `Europe/London`).
# Postgres still stores everything UTC; this only affects display.
# ADMIN_DISPLAY_TZ=Asia/Seoul
