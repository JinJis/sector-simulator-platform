# Frontend (apps/web) → sector-service
# Browser-side fetches go through the /api/sim Next.js rewrite (see
# apps/web/next.config.ts), which itself uses SECTOR_SERVICE_URL as the
# upstream, so no NEXT_PUBLIC_* var is needed.
#
# Leave unset on the host so Node falls back to http://localhost:8001. In
# Docker Compose the web service overrides this to the internal hostname
# (http://sector-service:8001).
# SECTOR_SERVICE_URL=http://sector-service:8001

# Postgres (packages/db / docker-compose `postgres` service).
# Host-side Prisma (migrate / seed / studio) connects via the host port
# mapped in docker-compose.local.yml (6543 by default, to avoid colliding
# with any system postgresql on 5432). In-cluster services use
# postgres:5432 — container-internal port is unchanged.
DATABASE_URL=postgresql://platform:platform@localhost:6543/platform_dev

# Used only inside docker-compose to initialize the postgres container —
# these match the defaults in DATABASE_URL above. Override all three
# together if you change credentials.
POSTGRES_USER=platform
POSTGRES_PASSWORD=platform
POSTGRES_DB=platform_dev

# services/sector-service (Fastify + tRPC) — upstream simulation-service.
# Inside docker-compose this is wired automatically; only needed here when
# running sector-service from the host (pnpm --filter @platform/sector-service dev).
# SIMULATION_SERVICE_URL=http://localhost:8000

# Agent orchestration + prediction.analyzeRationale
#
# ─── Vertex AI (M35, dual-provider) ───────────────────────────────────
# Drop a service-account JSON key at infra/secrets/vertex-ai-sa.json
# (see infra/secrets/README.md for setup). The same SA authenticates
# BOTH providers — Claude (opus tier) via AnthropicVertex and Gemini
# (sonnet + haiku tiers) via google-genai. `project_id` is read from
# the SA JSON itself when GOOGLE_CLOUD_PROJECT is left blank.
#
# These values are injected into the containers via `env_file:` in
# docker-compose.yml (NOT via `${VAR:-default}` interpolation), so a
# stray `export GOOGLE_CLOUD_LOCATION=...` in your shell can NOT
# override them — only this file can.
GOOGLE_GENAI_USE_VERTEXAI=true
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global
# Note: GOOGLE_APPLICATION_CREDENTIALS is hard-pinned in docker-compose.yml
# to /secrets/vertex-ai-sa.json (the in-container mount). Setting it
# here has no effect on the containerized services. Override only when
# running services from the host (`pnpm dev` outside Docker).
GOOGLE_APPLICATION_CREDENTIALS=/secrets/vertex-ai-sa.json
#
# ─── API-key fallback (dev only) ─────────────────────────────────────
# If you can't get Vertex AI access, get a Gemini key at
# https://aistudio.google.com/apikey and uncomment. Opus-tier (Claude)
# calls will fail in this mode — no Anthropic API-key path is wired
# (use Vertex for opus).
# GEMINI_API_KEY=
#
# Without either path configured, agent workflows return
# PRECONDITION_FAILED and the AI-analyze button is hidden.

# ─── services/data-pipeline ──────────────────────────────────────────
# Source selection — `yfinance` (default) or `fake` for offline smoke
# tests. Affects both quote ingest AND financials adapters; `fake`
# routes both US + KR financials through FakeFinancialsSource.
# INGEST_SOURCE=yfinance

# Daily quote refresh cron (UTC). Default 08:30 UTC = 17:30 KST,
# after KOSPI close and a few hours after US close.
# INGEST_CRON_QUOTES=30 8 * * *

# Set to `off` to disable the APScheduler entirely (manual /jobs/*
# triggers still work).
# INGEST_SCHEDULE=on

# M43 — legacy investment-frame feature gate. Default `false` means
# the data-pipeline skips the EDGAR/DART financials refresh and the
# legacy v1 prediction resolver. PredictionV2 resolver + quote
# refresh (used by V2's anchor + vol calc) run regardless. Flip ON
# to revive the legacy crons for backtest / migration / debugging.
# ENABLE_LEGACY_INVESTMENT_FEATURES=false

# Weekly financials refresh cron (UTC). Default Sun 04:00 UTC.
# Gated by ENABLE_LEGACY_INVESTMENT_FEATURES above.
# REFRESH_FINANCIALS_CRON=0 4 * * 0
# REFRESH_FINANCIALS_QUARTERS=8

# SEC EDGAR XBRL Facts API — required for US financials.
# Per SEC fair-access policy you MUST send a contact email in the
# User-Agent. Override this default with your own org + email before
# production use.
EDGAR_USER_AGENT="sector-simulator-platform info@example.com"

# OPEN DART (Korea Financial Supervisory Service) — required for KR
# financials. Free registration: https://opendart.fss.or.kr/
# Without this set, KR equities are silently skipped on refresh.
# DART_API_KEY=

# ─── apps/admin — login gate (M48 follow-up) ─────────────────────────
# Admin console (port 3100) is gated by a single env-driven account.
# Without all three of these set, every protected route redirects to
# /login which shows a "not configured" notice; no silent bypass.
# Cookie is signed with ADMIN_SESSION_SECRET (HMAC-SHA256, 7d TTL).
#
# Rotate the secret to invalidate all sessions immediately.
# Use a 32+ char random string — e.g. `openssl rand -hex 32`.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-before-shipping
ADMIN_SESSION_SECRET=replace-with-openssl-rand-hex-32

# Shared secret between apps/admin and sector-service so the admin
# app's RSC-side tRPC calls can hit userAdmin.* (listUsers / setTier)
# without needing a real user session. Sector-service treats requests
# carrying the matching `x-admin-internal-token` header as
# authenticated. NEVER reused on the browser side — admin Next.js
# only injects it server-side. Set the same value on both services.
# Rotate to immediately invalidate; unset to fall back to "require
# real session" (admin pages will then error with "admin endpoints
# require authentication").
ADMIN_INTERNAL_TOKEN=replace-with-openssl-rand-hex-32
