# Frontend → simulation-service
# Browser-side (inlined into the client bundle).
NEXT_PUBLIC_SIMULATION_SERVICE_URL=http://localhost:8000
# Server-side (RSC / route handlers). Leave unset on the host so Node falls
# back to the public URL above. In Docker Compose the web service overrides
# this to the internal hostname (http://simulation-service:8000).
# SIMULATION_SERVICE_URL=http://simulation-service:8000

# Postgres (packages/db / docker-compose `postgres` service).
# Host-side Prisma (migrate / seed / studio) connects via the host port
# mapped in docker-compose.local.yml (6543 by default, to avoid colliding
# with any system postgresql on 5432). In-cluster services use
# postgres:5432 — container-internal port is unchanged.
DATABASE_URL=postgresql://platform:platform@localhost:6543/platform_dev

# Used only inside docker-compose to initialize the postgres container —
# these match the defaults in DATABASE_URL above. Override all three
# together if you change credentials.
POSTGRES_USER=platform
POSTGRES_PASSWORD=platform
POSTGRES_DB=platform_dev

# services/sector-service (Fastify + tRPC). Inside docker-compose this is
# wired automatically; only needed here when running sector-service from
# the host (pnpm --filter @platform/sector-service dev).
# SIMULATION_SERVICE_URL — also the var name the Node service reads.
# When running sector-service on the host, point it at the simulation-service
# host port (8000), not the in-cluster name.
# SIMULATION_SERVICE_URL=http://localhost:8000

# Phase 2 later slice (agent orchestration)
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=
