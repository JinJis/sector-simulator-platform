// Phase 2 schema v1.
//
// Two entities for the entry slice:
//   - sectors   : 1 row per registered simulation. Source-of-truth for the
//                 sector picker once the FastAPI registry becomes
//                 DB-driven. For now the Python registry is still
//                 canonical and we just mirror its slugs here for the
//                 scenarios FK.
//   - scenarios : a named bundle of driver overrides for a given sector,
//                 plus notes. This is the first persisted user artifact.
//
// Multi-tenancy: tenant_id is intentionally absent. Auth (Clerk) lands in
// a later slice and that's when we add tenant scoping + Postgres RLS as
// the second line of defense.
//
// Conventions: snake_case columns, plural table names (CLAUDE.md).

generator client {
  provider      = "prisma-client-js"
  // linux-musl is needed for the alpine-based simulation-service / sector-
  // service Docker images. Native covers macOS + glibc Linux dev hosts.
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Sector {
  id             String   @id @default(cuid())
  slug           String   @unique
  name           String
  description    String?
  // Python module path for the in-code sim. Agent-generated sectors
  // currently start as `draft` with `source_module = null`; when a
  // Python sim is authored for them they're promoted to `live`.
  source_module  String?  @map("source_module")
  // M21: lifecycle status. The 3 in-code sims seed as "live"; agent-
  // proposed sectors land as "draft" and an admin promotes to "live".
  // "archived" hides from both user app and admin sector grids
  // without dropping the row.
  status         String   @default("live")
  // M21: traceability — when this row was created by promoting an
  // agent workflow, point at it so the audit/admin UI can deep-link
  // back to the original decomposition + cost.
  agent_workflow_id String? @map("agent_workflow_id")
  // M25a: who built this sector — null for the 3 seed sims, the
  // promoting user's id for agent-proposed sectors. Powers /my-sectors.
  created_by_user_id String? @map("created_by_user_id")
  created_by         User?   @relation("UserCreatedSectors", fields: [created_by_user_id], references: [id], onDelete: SetNull)
  created_at     DateTime @default(now()) @map("created_at")
  updated_at     DateTime @updatedAt        @map("updated_at")

  scenarios      Scenario[]
  equities       SectorEquity[]
  graph_nodes    GraphNode[]
  graph_edges    GraphEdge[]

  @@index([status])
  @@index([created_by_user_id])
  @@map("sectors")
}

model SectorEquity {
  // Equities Milestone 1: per-sector listed-company basket. Each row is a
  // ticker on a specific exchange that the editorial team considers a key
  // player for the sector. Used by the user app's Equities tab to show
  // how live driver state implies an impact on each company.
  //
  // Pricing is denormalized snapshot only (no time-series yet — that
  // lands with the data-pipeline-service milestone). All USD-converted
  // values use the snapshot date's FX so dashboards can show comparable
  // market caps across KR/US.

  id                  String   @id @default(cuid())
  sector_slug         String   @map("sector_slug")
  sector              Sector   @relation(fields: [sector_slug], references: [slug], onDelete: Cascade)

  ticker              String
  exchange            String   // NASDAQ / NYSE / KOSPI / KOSDAQ
  iso_country         String   @map("iso_country") // ISO 3166-1 alpha-2 — "US", "KR"
  company_name        String   @map("company_name")
  // Korean / native-script name for KR equities; null for pure-English names.
  company_name_local  String?  @map("company_name_local")

  // 0–100. Fraction of the company's revenue / earnings exposed to this
  // sector. A KOSPI conglomerate with 8% of revenue from memory might
  // still belong on memory-semi if it's a key swing stock there.
  sector_exposure_pct Float    @map("sector_exposure_pct")
  // Free-form rationale for inclusion (why this stock matters for this sector).
  rationale           String?

  // --- Snapshot quote (denormalized; refreshed by milestone-2 ingest) ---
  currency            String?  // "USD" or "KRW"
  last_close_local    Float?   @map("last_close_local")
  last_close_usd      Float?   @map("last_close_usd")
  last_close_date     DateTime? @map("last_close_date")
  market_cap_usd      Float?   @map("market_cap_usd")

  // --- Driver linkage (structured rationale) ---
  // JSON array of { driver: string, sign: "+"|"-", magnitude: "low"|"med"|"high", note?: string }.
  // The user-app Equities view reads this to project an impact direction
  // when the current driver state diverges from defaults. The MarketFactor
  // model (Milestone 2) replaces this with a normalized table.
  driver_links        Json     @default("[]") @map("driver_links")

  // Display ordering within the sector basket — defaults to 0, ties resolved
  // by market_cap_usd desc.
  display_order       Int      @default(0) @map("display_order")

  created_at          DateTime @default(now()) @map("created_at")
  updated_at          DateTime @updatedAt        @map("updated_at")

  quotes              EquityQuote[]
  financials          EquityFinancial[]
  graph_nodes         GraphNode[]
  watchlist_items     WatchlistItem[]
  predictions         Prediction[]

  @@unique([sector_slug, ticker, exchange])
  @@index([sector_slug])
  @@index([iso_country])
  @@map("sector_equities")
}

model EquityFinancial {
  // Phase 2 epic milestone 10: quarterly fundamentals per equity.
  // Mock-seeded for now (anchor on `market_cap_usd / 8` with deterministic
  // per-equity walk); DART/EDGAR adapters land as a follow-up M10b slice.
  //
  // Composite PK on (equity_id, fiscal_year, fiscal_quarter). Both fields
  // are denormalized alongside `period_end` so dashboards can group by
  // quarter without recomputing.

  equity_id      String   @map("equity_id")
  fiscal_year    Int      @map("fiscal_year")
  fiscal_quarter Int      @map("fiscal_quarter")  // 1..4

  period_end     DateTime @map("period_end") @db.Date

  revenue_usd       Float?   @map("revenue_usd")
  cogs_usd          Float?   @map("cogs_usd")
  gross_profit_usd  Float?   @map("gross_profit_usd")
  opex_usd          Float?   @map("opex_usd")
  ebitda_usd        Float?   @map("ebitda_usd")
  net_income_usd    Float?   @map("net_income_usd")
  capex_usd         Float?   @map("capex_usd")

  // Balance sheet (M10d) — totals only. Detailed sub-accounts can
  // come later; these three are enough for leverage / book-value plots.
  total_assets_usd       Float?   @map("total_assets_usd")
  total_liabilities_usd  Float?   @map("total_liabilities_usd")
  total_equity_usd       Float?   @map("total_equity_usd")

  source         String   @default("mock")
  inserted_at    DateTime @default(now()) @map("inserted_at")

  equity SectorEquity @relation(fields: [equity_id], references: [id], onDelete: Cascade)

  @@id([equity_id, fiscal_year, fiscal_quarter])
  @@index([equity_id, period_end(sort: Desc)])
  @@map("equity_financials")
}

model EquityQuote {
  // Daily close time-series per equity, refreshed by the data-pipeline
  // `refresh_quote_history` job (yfinance daily bars, last 90 days by
  // default). Used by the user-app sparkline column to give visual
  // context next to the editorial driver_links + implied-impact score.
  //
  // Composite PK on (equity_id, trade_date) — natural unique key per
  // bar. When this table crosses ~1M rows we'll migrate to a Timescale
  // hypertable; until then a regular Postgres table with the DESC
  // index covers the read pattern (last-N-days for one equity).

  equity_id   String   @map("equity_id")
  // The trading day. We deliberately store this as DATE (no time) — bars
  // are by-day, and intraday is out of scope until a different milestone.
  trade_date  DateTime @map("trade_date") @db.Date
  close_local Float    @map("close_local")
  // FX-normalized close in USD. Null when the FX rate for that day
  // wasn't available — the UI surfaces the gap.
  close_usd   Float?   @map("close_usd")
  volume      Float?
  source      String   @default("yfinance")
  inserted_at DateTime @default(now()) @map("inserted_at")

  equity SectorEquity @relation(fields: [equity_id], references: [id], onDelete: Cascade)

  @@id([equity_id, trade_date])
  @@index([equity_id, trade_date(sort: Desc)])
  @@map("equity_quotes")
}

model AgentWorkflow {
  // Mirrors agent-orchestration's WorkflowRecord. Written by the
  // Python service via direct asyncpg (no Prisma client on the Python
  // side — see services/agent-orchestration/agent_orchestration/repo.py).
  // The schema is duplicated there as raw SQL; this Prisma block is
  // the authoritative source for migrations.

  id           String   @id // wf_<hex16>
  kind         String
  // pending | running | succeeded | failed | cancelled
  status       String
  // Original input the workflow was started with.
  input        Json
  // Pydantic-validated agent output, populated on success.
  output       Json?
  // Stack-trace-ish error text on failure; null otherwise.
  error        String?
  // Roll-up cost in USD across every LLM call this workflow made.
  cost_usd     Float    @default(0)
  // M27: who triggered this workflow. Null for legacy admin-driven
  // rows; populated by sector-service after the orchestration call
  // returns. Powers the per-user monthly budget meter.
  user_id      String?  @map("user_id")
  created_at   DateTime @default(now()) @map("created_at")
  updated_at   DateTime @updatedAt        @map("updated_at")

  @@index([kind, created_at])
  @@index([status, updated_at])
  @@index([user_id, created_at(sort: Desc)])
  @@map("agent_workflows")
}

model GraphNode {
  // Phase 2 epic, milestone 7: the causal graph leaves Python source and
  // becomes editable DB state. `node_key` is the stable identifier used
  // by the Python sim (e.g. "ai_dram_demand_pb_y0"); the cuid `id` is
  // an opaque PK for the editor UI.
  //
  // `kind` ∈ {driver, intermediate, output, equity}. When kind="equity",
  // `equity_id` points at the SectorEquity row this node visualizes;
  // null otherwise.

  id           String   @id @default(cuid())
  sector_slug  String   @map("sector_slug")
  sector       Sector   @relation(fields: [sector_slug], references: [slug], onDelete: Cascade)

  node_key     String   @map("node_key")
  kind         String
  label        String
  group        String   @default("")
  unit         String?
  description  String?

  // Position overrides — null = use the kind-based default column layout.
  position_x   Float?   @map("position_x")
  position_y   Float?   @map("position_y")

  // FK to SectorEquity for kind="equity" nodes; SET NULL on equity
  // deletion so the graph topology survives (the orphan node can be
  // pruned by an admin action).
  equity_id    String?  @map("equity_id")
  equity       SectorEquity? @relation(fields: [equity_id], references: [id], onDelete: SetNull)

  created_at   DateTime @default(now()) @map("created_at")
  updated_at   DateTime @updatedAt        @map("updated_at")

  @@unique([sector_slug, node_key])
  @@index([sector_slug])
  @@index([equity_id])
  @@map("graph_nodes")
}

model GraphEdge {
  // Phase 2 epic, milestone 7: edges carry a runtime `weight` multiplier
  // (default 1.0) which milestone 9 plumbs into the Python sim at named
  // choke points. Sign is encoded in the weight itself (negative weight
  // = inverse relationship), so we don't need a separate sign column.
  //
  // `magnitude` is presentation-only ("low" / "med" / "high") — it
  // controls edge styling in the UI and does NOT enter the math.

  id           String   @id @default(cuid())
  sector_slug  String   @map("sector_slug")
  sector       Sector   @relation(fields: [sector_slug], references: [slug], onDelete: Cascade)

  source_key   String   @map("source_key")
  target_key   String   @map("target_key")
  label        String?

  weight       Float    @default(1.0)
  magnitude    String   @default("med")

  // Set by the seed/bootstrap path so we can distinguish edges that came
  // from the Python graph from edits or agent-generated ones later.
  origin       String   @default("seed") // seed | edit | agent
  author_label String?  @map("author_label")

  created_at   DateTime @default(now()) @map("created_at")
  updated_at   DateTime @updatedAt        @map("updated_at")

  @@unique([sector_slug, source_key, target_key])
  @@index([sector_slug])
  @@index([sector_slug, target_key])
  @@map("graph_edges")
}

model AuditLog {
  // Append-only record of mutations. CLAUDE.md mandates an audit log for
  // every admin action; we extend that to user-visible mutations as
  // well (scenario edits, graph edits) so we can attribute changes once
  // auth lands.

  id           String   @id @default(cuid())
  action       String   // e.g. "graph.upsertEdge", "scenario.update"
  sector_slug  String?  @map("sector_slug")
  // Full mutation payload (input + the row's `before` snapshot when
  // applicable). Bounded by `body_max_bytes` upstream — we don't enforce
  // here so trustless callers can't blow up the log.
  payload      Json
  author_label String?  @map("author_label")
  created_at   DateTime @default(now()) @map("created_at")

  @@index([action, created_at])
  @@index([sector_slug, created_at])
  @@map("audit_logs")
}

model User {
  // M20 auth foundation. Email + bcrypt password hash for now;
  // OAuth providers / SSO arrive as a separate slice. tenant_id will
  // join here when multi-tenant lands.
  id            String    @id @default(cuid())
  email         String    @unique
  password_hash String    @map("password_hash")
  name          String?
  // Future-friendly preference columns. The settings UI surfaces them
  // even though the platform doesn't act on them yet — wiring is a
  // follow-up slice.
  locale        String?   // "ko" | "en"
  theme         String?   // "dark" | "light" | "system"
  // M25a: pricing tier. "free" is the default; "premium" unlocks the
  // agent flow gating that we ship behind a soft (decorative) badge
  // today. The hard paywall lands when payment integration is wired.
  tier          String    @default("free")
  created_at    DateTime  @default(now()) @map("created_at")
  updated_at    DateTime  @updatedAt        @map("updated_at")

  sessions          Session[]
  watchlist_items   WatchlistItem[]
  created_sectors   Sector[]        @relation("UserCreatedSectors")
  billing_customer  BillingCustomer?
  predictions       Prediction[]
  user_score        UserScore?
  suggestions       SectorSuggestion[]
  suggestion_votes  SectorSuggestionVote[]

  @@map("users")
}

model WatchlistItem {
  // M24a: user-curated "관심 종목" list. One row per (user, equity)
  // pair. The `note` column lets users jot a one-line reason ("AI
  // 슈퍼사이클 후보") which surfaces on the /watchlist page.
  //
  // Authoritative on user_id + equity_id; cascade-delete on either
  // side so deleting an equity or a user cleans up automatically.

  id          String       @id @default(cuid())
  user_id     String       @map("user_id")
  user        User         @relation(fields: [user_id], references: [id], onDelete: Cascade)
  equity_id   String       @map("equity_id")
  equity      SectorEquity @relation(fields: [equity_id], references: [id], onDelete: Cascade)
  note        String?
  created_at  DateTime     @default(now()) @map("created_at")

  @@unique([user_id, equity_id])
  @@index([user_id, created_at(sort: Desc)])
  @@map("watchlist_items")
}

model Session {
  // Opaque session token persisted directly (not hashed) so the cookie
  // value is the lookup key. Rotating signed-token design lands when
  // session compromise becomes a real concern; for prototype scale a
  // 32-byte random token is enough.
  id          String   @id @default(cuid())
  user_id     String   @map("user_id")
  user        User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  token       String   @unique
  expires_at  DateTime @map("expires_at")
  // Per-request niceties — populated on creation, useful for the
  // settings "active sessions" surface when that ships.
  user_agent  String?  @map("user_agent")
  ip          String?  @map("ip")
  created_at  DateTime @default(now()) @map("created_at")

  @@index([token])
  @@index([user_id])
  @@map("sessions")
}

model Scenario {
  id                String   @id @default(cuid())
  sector_slug       String   @map("sector_slug")
  sector            Sector   @relation(fields: [sector_slug], references: [slug], onDelete: Cascade)
  name              String
  notes             String?
  // {driver_name: value} for any driver overridden from sector default.
  // Missing keys = use the sector's default for that driver.
  driver_overrides  Json     @map("driver_overrides")
  // Free-form author label. Becomes a real users(id) FK when auth lands.
  author_label      String?  @map("author_label")
  created_at        DateTime @default(now()) @map("created_at")
  updated_at        DateTime @updatedAt        @map("updated_at")

  @@index([sector_slug])
  @@map("scenarios")
}

// =====================================================================
// M26 — Stripe billing
// =====================================================================

model BillingCustomer {
  // One row per User who has been seen by Stripe Checkout (created on
  // first checkout attempt; never deleted, so the same stripe_customer_id
  // is reused across resubscriptions).
  id                   String   @id @default(cuid())
  user_id              String   @unique @map("user_id")
  user                 User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  stripe_customer_id   String   @unique @map("stripe_customer_id")
  email                String?
  created_at           DateTime @default(now()) @map("created_at")
  updated_at           DateTime @updatedAt        @map("updated_at")

  subscriptions        BillingSubscription[]

  @@map("billing_customers")
}

model BillingSubscription {
  // One row per Stripe Subscription. The active subscription gates
  // `user.tier = "premium"`. We keep historical rows so a downgraded
  // user's audit trail survives.
  id                       String           @id @default(cuid())
  customer_id              String           @map("customer_id")
  customer                 BillingCustomer  @relation(fields: [customer_id], references: [id], onDelete: Cascade)
  stripe_subscription_id   String           @unique @map("stripe_subscription_id")
  stripe_price_id          String           @map("stripe_price_id")
  // Stripe statuses: trialing | active | past_due | canceled | unpaid | incomplete | incomplete_expired
  status                   String
  // Snapshot from the latest webhook so we don't need to call Stripe
  // for routine reads.
  current_period_start     DateTime         @map("current_period_start")
  current_period_end       DateTime         @map("current_period_end")
  cancel_at_period_end     Boolean          @default(false) @map("cancel_at_period_end")
  canceled_at              DateTime?        @map("canceled_at")
  created_at               DateTime         @default(now()) @map("created_at")
  updated_at               DateTime         @updatedAt        @map("updated_at")

  @@index([customer_id, status])
  @@index([status, current_period_end])
  @@map("billing_subscriptions")
}

model BillingEvent {
  // Append-only log of every Stripe webhook event we've ingested.
  // Primarily used for webhook idempotency (event.id is reused if
  // Stripe retries) and post-hoc debugging.
  id                String   @id @default(cuid())
  stripe_event_id   String   @unique @map("stripe_event_id")
  type              String
  payload           Json
  received_at       DateTime @default(now()) @map("received_at")

  @@index([type, received_at])
  @@map("billing_events")
}


// =====================================================================
// M27 — Agent budget tracking
//   (extends existing AgentWorkflow with a user_id FK)
// =====================================================================
//
// We add the column via raw migration SQL so the existing AgentWorkflow
// Prisma model stays unchanged on the Python side. See the migration
// 20260524000000_billing_predictions_suggestions for the ALTER TABLE.
//
// Reading the column from Postgres uses raw SQL in sector-service since
// the Python agent-orchestration is the writer; Prisma stays read-only
// against that table.


// =====================================================================
// M32 — Community: predictions, scores, suggestions
// =====================================================================

model Prediction {
  // One row per user-submitted prediction. The user picks an equity,
  // a horizon ("1d" | "1w" | "1m"), and a predicted % change. We
  // snapshot the anchor_close at submission time so the resolver
  // (cron, future slice) can compute actual_pct against a stable
  // baseline.
  id              String   @id @default(cuid())
  user_id         String   @map("user_id")
  user            User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  equity_id       String   @map("equity_id")
  equity          SectorEquity @relation(fields: [equity_id], references: [id], onDelete: Cascade)
  // "1d" | "1w" | "1m" — short enough to fit on chips, no point in
  // enum-ing across tRPC boundary.
  horizon         String
  // Predicted % change vs anchor_close. Positive = up, negative = down.
  predicted_pct   Float    @map("predicted_pct")
  anchor_close    Float    @map("anchor_close")
  // Computed at submission time: anchor_close * (1 + predicted_pct/100).
  predicted_close Float    @map("predicted_close")
  // ISO date — when the prediction was made + the horizon-shifted target.
  anchor_at       DateTime @default(now()) @map("anchor_at")
  target_date     DateTime @map("target_date")
  // Optional linkage to a saved Scenario — explains "what assumptions
  // back this prediction".
  scenario_id     String?  @map("scenario_id")
  rationale       String?
  // M33: structured Claude-generated analysis of the rationale + the
  // linked scenario's driver overrides. Shape:
  //   { thesis_summary, supporting_factors[], risk_factors[],
  //     confidence: "low"|"med"|"high", edited_by_user }
  // Persisted alongside the prediction so the reviewer can see what
  // the LLM extracted even months after creation.
  rationale_analysis Json?  @map("rationale_analysis")
  // null until the prediction resolves at target_date.
  resolved        Boolean  @default(false)
  created_at      DateTime @default(now()) @map("created_at")

  result          PredictionResult?

  @@index([user_id, created_at(sort: Desc)])
  @@index([equity_id, created_at(sort: Desc)])
  @@index([resolved, target_date])
  @@map("predictions")
}

model PredictionResult {
  // Created by the resolver cron when target_date passes. score
  // formula in v1: max(0, 100 - |predicted_pct - actual_pct| * 5)
  // — i.e. ±20pp error wipes the score; perfect call gets 100.
  id               String   @id @default(cuid())
  prediction_id    String   @unique @map("prediction_id")
  prediction       Prediction @relation(fields: [prediction_id], references: [id], onDelete: Cascade)
  actual_close     Float    @map("actual_close")
  actual_pct       Float    @map("actual_pct")
  abs_error        Float    @map("abs_error")
  score            Float
  resolved_at      DateTime @default(now()) @map("resolved_at")

  @@map("prediction_results")
}

model UserScore {
  // Rolling per-user totals. Updated each time a prediction resolves;
  // a single row per user so the leaderboard is a flat query.
  user_id              String  @id @map("user_id")
  user                 User    @relation(fields: [user_id], references: [id], onDelete: Cascade)
  total_points         Float   @default(0) @map("total_points")
  predictions_made     Int     @default(0) @map("predictions_made")
  predictions_resolved Int     @default(0) @map("predictions_resolved")
  // Lifetime hits / lifetime resolved as a percentage; "hit" = score >= 50.
  hit_rate_pct         Float   @default(0) @map("hit_rate_pct")
  current_streak       Int     @default(0) @map("current_streak")
  best_streak          Int     @default(0) @map("best_streak")
  updated_at           DateTime @updatedAt @map("updated_at")

  @@index([total_points(sort: Desc)])
  @@map("user_scores")
}

model SectorSuggestion {
  // Community-submitted suggestion to improve a sector's structure —
  // e.g. "add NVDA as a memory-semi equity", "remove driver X because
  // it never moves". Editorial team reviews; an admin can flip status.
  id            String   @id @default(cuid())
  user_id       String   @map("user_id")
  user          User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  sector_slug   String   @map("sector_slug")
  // "add_driver" | "remove_driver" | "add_equity" | "remove_equity" |
  // "rename_node" | "rewire_edge" — kept as a free string so new kinds
  // don't need a migration. The payload JSONB carries kind-specific
  // detail (e.g. {"ticker": "NVDA", "rationale": "..."}).
  kind          String
  title         String
  body          String?
  payload       Json     @default("{}")
  // "open" | "under_review" | "approved" | "rejected" | "withdrawn"
  status        String   @default("open")
  // Snapshot of net votes (`+1` ups - `-1` downs). Updated transactionally
  // with each vote insert/update so the list query stays cheap.
  score         Int      @default(0)
  created_at    DateTime @default(now()) @map("created_at")
  updated_at    DateTime @updatedAt @map("updated_at")

  votes         SectorSuggestionVote[]

  @@index([sector_slug, status, score(sort: Desc)])
  @@index([user_id, created_at(sort: Desc)])
  @@map("sector_suggestions")
}

model SectorSuggestionVote {
  // One vote per (user, suggestion). Value is +1 or -1.
  suggestion_id  String   @map("suggestion_id")
  suggestion     SectorSuggestion @relation(fields: [suggestion_id], references: [id], onDelete: Cascade)
  user_id        String   @map("user_id")
  user           User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  value          Int      // +1 | -1
  created_at     DateTime @default(now()) @map("created_at")

  @@id([suggestion_id, user_id])
  @@index([user_id, created_at(sort: Desc)])
  @@map("sector_suggestion_votes")
}
