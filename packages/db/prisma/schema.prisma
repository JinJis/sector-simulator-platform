// Phase 2 schema v1.
//
// Two entities for the entry slice:
//   - sectors   : 1 row per registered simulation. Source-of-truth for the
//                 sector picker once the FastAPI registry becomes
//                 DB-driven. For now the Python registry is still
//                 canonical and we just mirror its slugs here for the
//                 scenarios FK.
//   - scenarios : a named bundle of driver overrides for a given sector,
//                 plus notes. This is the first persisted user artifact.
//
// Multi-tenancy: tenant_id is intentionally absent. Auth (Clerk) lands in
// a later slice and that's when we add tenant scoping + Postgres RLS as
// the second line of defense.
//
// Conventions: snake_case columns, plural table names (CLAUDE.md).

generator client {
  provider      = "prisma-client-js"
  // linux-musl is needed for the alpine-based simulation-service / sector-
  // service Docker images. Native covers macOS + glibc Linux dev hosts.
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Sector {
  id             String   @id @default(cuid())
  slug           String   @unique
  name           String
  description    String?
  // Python module path for the in-code sim. Agent-generated sectors will
  // store a code-version ref instead (Phase 2 later slice).
  source_module  String?  @map("source_module")
  created_at     DateTime @default(now()) @map("created_at")
  updated_at     DateTime @updatedAt        @map("updated_at")

  scenarios      Scenario[]
  equities       SectorEquity[]

  @@map("sectors")
}

model SectorEquity {
  // Equities Milestone 1: per-sector listed-company basket. Each row is a
  // ticker on a specific exchange that the editorial team considers a key
  // player for the sector. Used by the user app's Equities tab to show
  // how live driver state implies an impact on each company.
  //
  // Pricing is denormalized snapshot only (no time-series yet — that
  // lands with the data-pipeline-service milestone). All USD-converted
  // values use the snapshot date's FX so dashboards can show comparable
  // market caps across KR/US.

  id                  String   @id @default(cuid())
  sector_slug         String   @map("sector_slug")
  sector              Sector   @relation(fields: [sector_slug], references: [slug], onDelete: Cascade)

  ticker              String
  exchange            String   // NASDAQ / NYSE / KOSPI / KOSDAQ
  iso_country         String   @map("iso_country") // ISO 3166-1 alpha-2 — "US", "KR"
  company_name        String   @map("company_name")
  // Korean / native-script name for KR equities; null for pure-English names.
  company_name_local  String?  @map("company_name_local")

  // 0–100. Fraction of the company's revenue / earnings exposed to this
  // sector. A KOSPI conglomerate with 8% of revenue from memory might
  // still belong on memory-semi if it's a key swing stock there.
  sector_exposure_pct Float    @map("sector_exposure_pct")
  // Free-form rationale for inclusion (why this stock matters for this sector).
  rationale           String?

  // --- Snapshot quote (denormalized; refreshed by milestone-2 ingest) ---
  currency            String?  // "USD" or "KRW"
  last_close_local    Float?   @map("last_close_local")
  last_close_usd      Float?   @map("last_close_usd")
  last_close_date     DateTime? @map("last_close_date")
  market_cap_usd      Float?   @map("market_cap_usd")

  // --- Driver linkage (structured rationale) ---
  // JSON array of { driver: string, sign: "+"|"-", magnitude: "low"|"med"|"high", note?: string }.
  // The user-app Equities view reads this to project an impact direction
  // when the current driver state diverges from defaults. The MarketFactor
  // model (Milestone 2) replaces this with a normalized table.
  driver_links        Json     @default("[]") @map("driver_links")

  // Display ordering within the sector basket — defaults to 0, ties resolved
  // by market_cap_usd desc.
  display_order       Int      @default(0) @map("display_order")

  created_at          DateTime @default(now()) @map("created_at")
  updated_at          DateTime @updatedAt        @map("updated_at")

  quotes              EquityQuote[]

  @@unique([sector_slug, ticker, exchange])
  @@index([sector_slug])
  @@index([iso_country])
  @@map("sector_equities")
}

model EquityQuote {
  // Daily close time-series per equity, refreshed by the data-pipeline
  // `refresh_quote_history` job (yfinance daily bars, last 90 days by
  // default). Used by the user-app sparkline column to give visual
  // context next to the editorial driver_links + implied-impact score.
  //
  // Composite PK on (equity_id, trade_date) — natural unique key per
  // bar. When this table crosses ~1M rows we'll migrate to a Timescale
  // hypertable; until then a regular Postgres table with the DESC
  // index covers the read pattern (last-N-days for one equity).

  equity_id   String   @map("equity_id")
  // The trading day. We deliberately store this as DATE (no time) — bars
  // are by-day, and intraday is out of scope until a different milestone.
  trade_date  DateTime @map("trade_date") @db.Date
  close_local Float    @map("close_local")
  // FX-normalized close in USD. Null when the FX rate for that day
  // wasn't available — the UI surfaces the gap.
  close_usd   Float?   @map("close_usd")
  volume      Float?
  source      String   @default("yfinance")
  inserted_at DateTime @default(now()) @map("inserted_at")

  equity SectorEquity @relation(fields: [equity_id], references: [id], onDelete: Cascade)

  @@id([equity_id, trade_date])
  @@index([equity_id, trade_date(sort: Desc)])
  @@map("equity_quotes")
}

model AgentWorkflow {
  // Mirrors agent-orchestration's WorkflowRecord. Written by the
  // Python service via direct asyncpg (no Prisma client on the Python
  // side — see services/agent-orchestration/agent_orchestration/repo.py).
  // The schema is duplicated there as raw SQL; this Prisma block is
  // the authoritative source for migrations.

  id           String   @id // wf_<hex16>
  kind         String
  // pending | running | succeeded | failed | cancelled
  status       String
  // Original input the workflow was started with.
  input        Json
  // Pydantic-validated agent output, populated on success.
  output       Json?
  // Stack-trace-ish error text on failure; null otherwise.
  error        String?
  // Roll-up cost in USD across every LLM call this workflow made.
  cost_usd     Float    @default(0)
  created_at   DateTime @default(now()) @map("created_at")
  updated_at   DateTime @updatedAt        @map("updated_at")

  @@index([kind, created_at])
  @@index([status, updated_at])
  @@map("agent_workflows")
}

model Scenario {
  id                String   @id @default(cuid())
  sector_slug       String   @map("sector_slug")
  sector            Sector   @relation(fields: [sector_slug], references: [slug], onDelete: Cascade)
  name              String
  notes             String?
  // {driver_name: value} for any driver overridden from sector default.
  // Missing keys = use the sector's default for that driver.
  driver_overrides  Json     @map("driver_overrides")
  // Free-form author label. Becomes a real users(id) FK when auth lands.
  author_label      String?  @map("author_label")
  created_at        DateTime @default(now()) @map("created_at")
  updated_at        DateTime @updatedAt        @map("updated_at")

  @@index([sector_slug])
  @@map("scenarios")
}
