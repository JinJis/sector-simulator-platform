// Phase 2 schema v1.
//
// Two entities for the entry slice:
//   - sectors   : 1 row per registered simulation. Source-of-truth for the
//                 sector picker once the FastAPI registry becomes
//                 DB-driven. For now the Python registry is still
//                 canonical and we just mirror its slugs here for the
//                 scenarios FK.
//   - scenarios : a named bundle of driver overrides for a given sector,
//                 plus notes. This is the first persisted user artifact.
//
// Multi-tenancy: tenant_id is intentionally absent. Auth (Clerk) lands in
// a later slice and that's when we add tenant scoping + Postgres RLS as
// the second line of defense.
//
// Conventions: snake_case columns, plural table names (CLAUDE.md).

generator client {
  provider      = "prisma-client-js"
  // linux-musl is needed for the alpine-based simulation-service / sector-
  // service Docker images. Native covers macOS + glibc Linux dev hosts.
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Sector {
  // M36 pivot note: in product language a `Sector` is a `Vision` — a
  // bold technology question ("Will commercial fusion reach grid parity
  // by 2040?"). The DB column name is kept for migration-history hygiene;
  // tRPC exposes the same data via the new `vision.*` namespace.
  id                 String   @id @default(cuid())
  slug               String   @unique
  name               String
  description        String?
  // M36: one-sentence framing question rendered above the hero gauge.
  // e.g. "By when will compute in orbit be commercially viable?"
  // Null on legacy rows; the Vision Builder agent (M41) populates this
  // for new visions.
  vision_question    String?  @map("vision_question")
  // M36: opts a Sector row in/out of the new Vision Monitor UI. Set
  // true by default for forward-compat — legacy investment-side rows
  // remain visible. Toggle false to soft-hide a sector from /visions
  // without dropping it.
  is_vision_eligible Boolean  @default(true) @map("is_vision_eligible")
  // Python module path for the in-code sim. Agent-generated sectors
  // currently start as `draft` with `source_module = null`; when a
  // Python sim is authored for them they're promoted to `live`.
  source_module      String?  @map("source_module")
  // M21: lifecycle status. The 3 in-code sims seed as "live"; agent-
  // proposed sectors land as "draft" and an admin promotes to "live".
  // "archived" hides from both user app and admin sector grids
  // without dropping the row.
  status             String   @default("live")
  // M21: traceability — when this row was created by promoting an
  // agent workflow, point at it so the audit/admin UI can deep-link
  // back to the original decomposition + cost.
  agent_workflow_id  String?  @map("agent_workflow_id")
  // M25a: who built this sector — null for the 3 seed sims, the
  // promoting user's id for agent-proposed sectors. Powers /my-sectors.
  created_by_user_id String?  @map("created_by_user_id")
  created_by         User?    @relation("UserCreatedSectors", fields: [created_by_user_id], references: [id], onDelete: SetNull)
  created_at         DateTime @default(now()) @map("created_at")
  updated_at         DateTime @updatedAt @map("updated_at")

  scenarios   Scenario[]
  equities    SectorEquity[]
  graph_nodes GraphNode[]
  graph_edges GraphEdge[]

  // M36: Vision Feasibility Monitor domain.
  capabilities        Capability[]
  signals             Signal[]
  risks               Risk[]
  feasibility_history VisionFeasibility[]
  // M45: Actor layer — companies + labs + governments competing on
  // capabilities. Many-to-many via VisionActor.
  vision_actors       VisionActor[]

  @@index([status])
  @@index([created_by_user_id])
  @@index([is_vision_eligible])
  @@map("sectors")
}

/// @deprecated M36 (2026-05-23) — pivot from "Sector Simulator" investment
/// surface to "Vision Feasibility Monitor". Rows retained; tables hidden
/// from the user app when ENABLE_LEGACY_INVESTMENT_FEATURES=false (M43).
/// No new writes after M43. See docs/PIVOT.md §1.5 + docs/REFACTOR.md §7.1.
model SectorEquity {
  // Equities Milestone 1: per-sector listed-company basket. Each row is a
  // ticker on a specific exchange that the editorial team considers a key
  // player for the sector. Used by the user app's Equities tab to show
  // how live driver state implies an impact on each company.
  //
  // Pricing is denormalized snapshot only (no time-series yet — that
  // lands with the data-pipeline-service milestone). All USD-converted
  // values use the snapshot date's FX so dashboards can show comparable
  // market caps across KR/US.

  id          String @id @default(cuid())
  sector_slug String @map("sector_slug")
  sector      Sector @relation(fields: [sector_slug], references: [slug], onDelete: Cascade)

  ticker             String
  exchange           String // NASDAQ / NYSE / KOSPI / KOSDAQ
  iso_country        String  @map("iso_country") // ISO 3166-1 alpha-2 — "US", "KR"
  company_name       String  @map("company_name")
  // Korean / native-script name for KR equities; null for pure-English names.
  company_name_local String? @map("company_name_local")

  // 0–100. Fraction of the company's revenue / earnings exposed to this
  // sector. A KOSPI conglomerate with 8% of revenue from memory might
  // still belong on memory-semi if it's a key swing stock there.
  sector_exposure_pct Float   @map("sector_exposure_pct")
  // Free-form rationale for inclusion (why this stock matters for this sector).
  rationale           String?

  // --- Snapshot quote (denormalized; refreshed by milestone-2 ingest) ---
  currency         String? // "USD" or "KRW"
  last_close_local Float?    @map("last_close_local")
  last_close_usd   Float?    @map("last_close_usd")
  last_close_date  DateTime? @map("last_close_date")
  market_cap_usd   Float?    @map("market_cap_usd")

  // --- Driver linkage (structured rationale) ---
  // JSON array of { driver: string, sign: "+"|"-", magnitude: "low"|"med"|"high", note?: string }.
  // The user-app Equities view reads this to project an impact direction
  // when the current driver state diverges from defaults. The MarketFactor
  // model (Milestone 2) replaces this with a normalized table.
  driver_links Json @default("[]") @map("driver_links")

  // Display ordering within the sector basket — defaults to 0, ties resolved
  // by market_cap_usd desc.
  display_order Int @default(0) @map("display_order")

  created_at DateTime @default(now()) @map("created_at")
  updated_at DateTime @updatedAt @map("updated_at")

  quotes          EquityQuote[]
  financials      EquityFinancial[]
  graph_nodes     GraphNode[]
  watchlist_items WatchlistItem[]
  predictions     Prediction[]
  predictions_v2  PredictionV2[]

  @@unique([sector_slug, ticker, exchange])
  @@index([sector_slug])
  @@index([iso_country])
  @@map("sector_equities")
}

/// @deprecated M36 — see SectorEquity. Retained; not written after M43.
model EquityFinancial {
  // Phase 2 epic milestone 10: quarterly fundamentals per equity.
  // Mock-seeded for now (anchor on `market_cap_usd / 8` with deterministic
  // per-equity walk); DART/EDGAR adapters land as a follow-up M10b slice.
  //
  // Composite PK on (equity_id, fiscal_year, fiscal_quarter). Both fields
  // are denormalized alongside `period_end` so dashboards can group by
  // quarter without recomputing.

  equity_id      String @map("equity_id")
  fiscal_year    Int    @map("fiscal_year")
  fiscal_quarter Int    @map("fiscal_quarter") // 1..4

  period_end DateTime @map("period_end") @db.Date

  revenue_usd      Float? @map("revenue_usd")
  cogs_usd         Float? @map("cogs_usd")
  gross_profit_usd Float? @map("gross_profit_usd")
  opex_usd         Float? @map("opex_usd")
  ebitda_usd       Float? @map("ebitda_usd")
  net_income_usd   Float? @map("net_income_usd")
  capex_usd        Float? @map("capex_usd")

  // Balance sheet (M10d) — totals only. Detailed sub-accounts can
  // come later; these three are enough for leverage / book-value plots.
  total_assets_usd      Float? @map("total_assets_usd")
  total_liabilities_usd Float? @map("total_liabilities_usd")
  total_equity_usd      Float? @map("total_equity_usd")

  source      String   @default("mock")
  inserted_at DateTime @default(now()) @map("inserted_at")

  equity SectorEquity @relation(fields: [equity_id], references: [id], onDelete: Cascade)

  @@id([equity_id, fiscal_year, fiscal_quarter])
  @@index([equity_id, period_end(sort: Desc)])
  @@map("equity_financials")
}

/// @deprecated M36 — see SectorEquity. Retained; not written after M43.
model EquityQuote {
  // Daily close time-series per equity, refreshed by the data-pipeline
  // `refresh_quote_history` job (yfinance daily bars, last 90 days by
  // default). Used by the user-app sparkline column to give visual
  // context next to the editorial driver_links + implied-impact score.
  //
  // Composite PK on (equity_id, trade_date) — natural unique key per
  // bar. When this table crosses ~1M rows we'll migrate to a Timescale
  // hypertable; until then a regular Postgres table with the DESC
  // index covers the read pattern (last-N-days for one equity).

  equity_id   String   @map("equity_id")
  // The trading day. We deliberately store this as DATE (no time) — bars
  // are by-day, and intraday is out of scope until a different milestone.
  trade_date  DateTime @map("trade_date") @db.Date
  close_local Float    @map("close_local")
  // FX-normalized close in USD. Null when the FX rate for that day
  // wasn't available — the UI surfaces the gap.
  close_usd   Float?   @map("close_usd")
  volume      Float?
  source      String   @default("yfinance")
  inserted_at DateTime @default(now()) @map("inserted_at")

  equity SectorEquity @relation(fields: [equity_id], references: [id], onDelete: Cascade)

  @@id([equity_id, trade_date])
  @@index([equity_id, trade_date(sort: Desc)])
  @@map("equity_quotes")
}

model AgentWorkflow {
  // Mirrors agent-orchestration's WorkflowRecord. Written by the
  // Python service via direct asyncpg (no Prisma client on the Python
  // side — see services/agent-orchestration/agent_orchestration/repo.py).
  // The schema is duplicated there as raw SQL; this Prisma block is
  // the authoritative source for migrations.

  id         String   @id // wf_<hex16>
  kind       String
  // pending | running | succeeded | failed | cancelled
  status     String
  // Original input the workflow was started with.
  input      Json
  // Pydantic-validated agent output, populated on success.
  output     Json?
  // Stack-trace-ish error text on failure; null otherwise.
  error      String?
  // Roll-up cost in USD across every LLM call this workflow made.
  cost_usd   Float    @default(0)
  // M27: who triggered this workflow. Null for legacy admin-driven
  // rows; populated by sector-service after the orchestration call
  // returns. Powers the per-user monthly budget meter.
  user_id    String?  @map("user_id")
  created_at DateTime @default(now()) @map("created_at")
  updated_at DateTime @updatedAt @map("updated_at")

  @@index([kind, created_at])
  @@index([status, updated_at])
  @@index([user_id, created_at(sort: Desc)])
  @@map("agent_workflows")
}

model GraphNode {
  // Phase 2 epic, milestone 7: the causal graph leaves Python source and
  // becomes editable DB state. `node_key` is the stable identifier used
  // by the Python sim (e.g. "ai_dram_demand_pb_y0"); the cuid `id` is
  // an opaque PK for the editor UI.
  //
  // `kind` ∈ {driver, intermediate, output, equity}. When kind="equity",
  // `equity_id` points at the SectorEquity row this node visualizes;
  // null otherwise.

  id          String @id @default(cuid())
  sector_slug String @map("sector_slug")
  sector      Sector @relation(fields: [sector_slug], references: [slug], onDelete: Cascade)

  node_key    String  @map("node_key")
  kind        String
  label       String
  group       String  @default("")
  unit        String?
  description String?

  // Position overrides — null = use the kind-based default column layout.
  position_x Float? @map("position_x")
  position_y Float? @map("position_y")

  // FK to SectorEquity for kind="equity" nodes; SET NULL on equity
  // deletion so the graph topology survives (the orphan node can be
  // pruned by an admin action).
  equity_id String?       @map("equity_id")
  equity    SectorEquity? @relation(fields: [equity_id], references: [id], onDelete: SetNull)

  created_at DateTime @default(now()) @map("created_at")
  updated_at DateTime @updatedAt @map("updated_at")

  @@unique([sector_slug, node_key])
  @@index([sector_slug])
  @@index([equity_id])
  @@map("graph_nodes")
}

model GraphEdge {
  // Phase 2 epic, milestone 7: edges carry a runtime `weight` multiplier
  // (default 1.0) which milestone 9 plumbs into the Python sim at named
  // choke points. Sign is encoded in the weight itself (negative weight
  // = inverse relationship), so we don't need a separate sign column.
  //
  // `magnitude` is presentation-only ("low" / "med" / "high") — it
  // controls edge styling in the UI and does NOT enter the math.

  id          String @id @default(cuid())
  sector_slug String @map("sector_slug")
  sector      Sector @relation(fields: [sector_slug], references: [slug], onDelete: Cascade)

  source_key String  @map("source_key")
  target_key String  @map("target_key")
  label      String?

  weight    Float  @default(1.0)
  magnitude String @default("med")

  // Set by the seed/bootstrap path so we can distinguish edges that came
  // from the Python graph from edits or agent-generated ones later.
  origin       String  @default("seed") // seed | edit | agent
  author_label String? @map("author_label")

  created_at DateTime @default(now()) @map("created_at")
  updated_at DateTime @updatedAt @map("updated_at")

  @@unique([sector_slug, source_key, target_key])
  @@index([sector_slug])
  @@index([sector_slug, target_key])
  @@map("graph_edges")
}

model AuditLog {
  // Append-only record of mutations. CLAUDE.md mandates an audit log for
  // every admin action; we extend that to user-visible mutations as
  // well (scenario edits, graph edits) so we can attribute changes once
  // auth lands.

  id           String   @id @default(cuid())
  action       String // e.g. "graph.upsertEdge", "scenario.update"
  sector_slug  String?  @map("sector_slug")
  // Full mutation payload (input + the row's `before` snapshot when
  // applicable). Bounded by `body_max_bytes` upstream — we don't enforce
  // here so trustless callers can't blow up the log.
  payload      Json
  author_label String?  @map("author_label")
  created_at   DateTime @default(now()) @map("created_at")

  @@index([action, created_at])
  @@index([sector_slug, created_at])
  @@map("audit_logs")
}

model User {
  // M20 auth foundation. Email + bcrypt password hash for now;
  // OAuth providers / SSO arrive as a separate slice. tenant_id will
  // join here when multi-tenant lands.
  id            String   @id @default(cuid())
  email         String   @unique
  password_hash String   @map("password_hash")
  name          String?
  // Future-friendly preference columns. The settings UI surfaces them
  // even though the platform doesn't act on them yet — wiring is a
  // follow-up slice.
  locale        String? // "ko" | "en"
  theme         String? // "dark" | "light" | "system"
  // M25a: pricing tier. "free" is the default; "premium" unlocks the
  // agent flow gating that we ship behind a soft (decorative) badge
  // today. The hard paywall lands when payment integration is wired.
  tier          String   @default("free")
  created_at    DateTime @default(now()) @map("created_at")
  updated_at    DateTime @updatedAt @map("updated_at")

  sessions         Session[]
  watchlist_items  WatchlistItem[]
  created_sectors  Sector[]               @relation("UserCreatedSectors")
  billing_customer BillingCustomer?
  predictions      Prediction[]
  user_score       UserScore?
  suggestions      SectorSuggestion[]
  suggestion_votes SectorSuggestionVote[]

  // M46a — Community 3.0
  community_proposals       CommunityProposal[] @relation("ProposalAuthor")
  community_proposal_decisions CommunityProposal[] @relation("ProposalDecidedBy")
  community_proposal_votes  ProposalVote[]
  community_proposal_replies ProposalReply[]
  // M46b — PredictionV2
  predictions_v2            PredictionV2[]      @relation("UserPredictionsV2")
  // M46c — Reputation + Follow
  reputation                UserReputation?
  point_events              PointEvent[]
  follows_out               UserFollow[]    @relation("FollowsOut")
  follows_in                UserFollow[]    @relation("FollowsIn")

  @@map("users")
}

/// @deprecated M36 — equity-watchlist concept retired with pivot. Rows
/// retained; UI gated by ENABLE_LEGACY_INVESTMENT_FEATURES. May resurface
/// post-pivot as a "vision watchlist" but with a different schema.
model WatchlistItem {
  // M24a: user-curated "관심 종목" list. One row per (user, equity)
  // pair. The `note` column lets users jot a one-line reason ("AI
  // 슈퍼사이클 후보") which surfaces on the /watchlist page.
  //
  // Authoritative on user_id + equity_id; cascade-delete on either
  // side so deleting an equity or a user cleans up automatically.

  id         String       @id @default(cuid())
  user_id    String       @map("user_id")
  user       User         @relation(fields: [user_id], references: [id], onDelete: Cascade)
  equity_id  String       @map("equity_id")
  equity     SectorEquity @relation(fields: [equity_id], references: [id], onDelete: Cascade)
  note       String?
  created_at DateTime     @default(now()) @map("created_at")

  @@unique([user_id, equity_id])
  @@index([user_id, created_at(sort: Desc)])
  @@map("watchlist_items")
}

model Session {
  // Opaque session token persisted directly (not hashed) so the cookie
  // value is the lookup key. Rotating signed-token design lands when
  // session compromise becomes a real concern; for prototype scale a
  // 32-byte random token is enough.
  id         String   @id @default(cuid())
  user_id    String   @map("user_id")
  user       User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  token      String   @unique
  expires_at DateTime @map("expires_at")
  // Per-request niceties — populated on creation, useful for the
  // settings "active sessions" surface when that ships.
  user_agent String?  @map("user_agent")
  ip         String?  @map("ip")
  created_at DateTime @default(now()) @map("created_at")

  @@index([token])
  @@index([user_id])
  @@map("sessions")
}

model Scenario {
  id               String   @id @default(cuid())
  sector_slug      String   @map("sector_slug")
  sector           Sector   @relation(fields: [sector_slug], references: [slug], onDelete: Cascade)
  name             String
  notes            String?
  // {driver_name: value} for any driver overridden from sector default.
  // Missing keys = use the sector's default for that driver.
  driver_overrides Json     @map("driver_overrides")
  // Free-form author label. Becomes a real users(id) FK when auth lands.
  author_label     String?  @map("author_label")
  created_at       DateTime @default(now()) @map("created_at")
  updated_at       DateTime @updatedAt @map("updated_at")

  @@index([sector_slug])
  @@map("scenarios")
}

// =====================================================================
// M26 — Stripe billing
// =====================================================================

model BillingCustomer {
  // One row per User who has been seen by Stripe Checkout (created on
  // first checkout attempt; never deleted, so the same stripe_customer_id
  // is reused across resubscriptions).
  id                 String   @id @default(cuid())
  user_id            String   @unique @map("user_id")
  user               User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  stripe_customer_id String   @unique @map("stripe_customer_id")
  email              String?
  created_at         DateTime @default(now()) @map("created_at")
  updated_at         DateTime @updatedAt @map("updated_at")

  subscriptions BillingSubscription[]

  @@map("billing_customers")
}

model BillingSubscription {
  // One row per Stripe Subscription. The active subscription gates
  // `user.tier = "premium"`. We keep historical rows so a downgraded
  // user's audit trail survives.
  id                     String          @id @default(cuid())
  customer_id            String          @map("customer_id")
  customer               BillingCustomer @relation(fields: [customer_id], references: [id], onDelete: Cascade)
  stripe_subscription_id String          @unique @map("stripe_subscription_id")
  stripe_price_id        String          @map("stripe_price_id")
  // Stripe statuses: trialing | active | past_due | canceled | unpaid | incomplete | incomplete_expired
  status                 String
  // Snapshot from the latest webhook so we don't need to call Stripe
  // for routine reads.
  current_period_start   DateTime        @map("current_period_start")
  current_period_end     DateTime        @map("current_period_end")
  cancel_at_period_end   Boolean         @default(false) @map("cancel_at_period_end")
  canceled_at            DateTime?       @map("canceled_at")
  created_at             DateTime        @default(now()) @map("created_at")
  updated_at             DateTime        @updatedAt @map("updated_at")

  @@index([customer_id, status])
  @@index([status, current_period_end])
  @@map("billing_subscriptions")
}

model BillingEvent {
  // Append-only log of every Stripe webhook event we've ingested.
  // Primarily used for webhook idempotency (event.id is reused if
  // Stripe retries) and post-hoc debugging.
  id              String   @id @default(cuid())
  stripe_event_id String   @unique @map("stripe_event_id")
  type            String
  payload         Json
  received_at     DateTime @default(now()) @map("received_at")

  @@index([type, received_at])
  @@map("billing_events")
}

// =====================================================================
// M27 — Agent budget tracking
//   (extends existing AgentWorkflow with a user_id FK)
// =====================================================================
//
// We add the column via raw migration SQL so the existing AgentWorkflow
// Prisma model stays unchanged on the Python side. See the migration
// 20260524000000_billing_predictions_suggestions for the ALTER TABLE.
//
// Reading the column from Postgres uses raw SQL in sector-service since
// the Python agent-orchestration is the writer; Prisma stays read-only
// against that table.

// =====================================================================
// M32 — Community: predictions, scores, suggestions
// =====================================================================

/// @deprecated M36 — stock-prediction game retired with pivot. Rows
/// retained; UI gated by ENABLE_LEGACY_INVESTMENT_FEATURES. M31 backtest
/// harness when resumed will reframe forecasting around Vision feasibility,
/// not equity price. See docs/PIVOT.md §1.5.
model Prediction {
  // One row per user-submitted prediction. The user picks an equity,
  // a horizon ("1d" | "1w" | "1m"), and a predicted % change. We
  // snapshot the anchor_close at submission time so the resolver
  // (cron, future slice) can compute actual_pct against a stable
  // baseline.
  id                 String       @id @default(cuid())
  user_id            String       @map("user_id")
  user               User         @relation(fields: [user_id], references: [id], onDelete: Cascade)
  equity_id          String       @map("equity_id")
  equity             SectorEquity @relation(fields: [equity_id], references: [id], onDelete: Cascade)
  // "1d" | "1w" | "1m" — short enough to fit on chips, no point in
  // enum-ing across tRPC boundary.
  horizon            String
  // Predicted % change vs anchor_close. Positive = up, negative = down.
  predicted_pct      Float        @map("predicted_pct")
  anchor_close       Float        @map("anchor_close")
  // Computed at submission time: anchor_close * (1 + predicted_pct/100).
  predicted_close    Float        @map("predicted_close")
  // ISO date — when the prediction was made + the horizon-shifted target.
  anchor_at          DateTime     @default(now()) @map("anchor_at")
  target_date        DateTime     @map("target_date")
  // Optional linkage to a saved Scenario — explains "what assumptions
  // back this prediction".
  scenario_id        String?      @map("scenario_id")
  rationale          String?
  // M33: structured Claude-generated analysis of the rationale + the
  // linked scenario's driver overrides. Shape:
  //   { thesis_summary, supporting_factors[], risk_factors[],
  //     confidence: "low"|"med"|"high", edited_by_user }
  // Persisted alongside the prediction so the reviewer can see what
  // the LLM extracted even months after creation.
  rationale_analysis Json?        @map("rationale_analysis")
  // null until the prediction resolves at target_date.
  resolved           Boolean      @default(false)
  created_at         DateTime     @default(now()) @map("created_at")

  result PredictionResult?

  @@index([user_id, created_at(sort: Desc)])
  @@index([equity_id, created_at(sort: Desc)])
  @@index([resolved, target_date])
  @@map("predictions")
}

/// @deprecated M36 — see Prediction. Retained; resolver cron disabled
/// by default after M43.
model PredictionResult {
  // Created by the resolver cron when target_date passes. score
  // formula in v1: max(0, 100 - |predicted_pct - actual_pct| * 5)
  // — i.e. ±20pp error wipes the score; perfect call gets 100.
  id            String     @id @default(cuid())
  prediction_id String     @unique @map("prediction_id")
  prediction    Prediction @relation(fields: [prediction_id], references: [id], onDelete: Cascade)
  actual_close  Float      @map("actual_close")
  actual_pct    Float      @map("actual_pct")
  abs_error     Float      @map("abs_error")
  score         Float
  resolved_at   DateTime   @default(now()) @map("resolved_at")

  @@map("prediction_results")
}

/// @deprecated M36 — leaderboard scored prediction game retired. Retained
/// in case prediction surface is reactivated; M31 backtest reframe may
/// supersede entirely.
model UserScore {
  // Rolling per-user totals. Updated each time a prediction resolves;
  // a single row per user so the leaderboard is a flat query.
  user_id              String   @id @map("user_id")
  user                 User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  total_points         Float    @default(0) @map("total_points")
  predictions_made     Int      @default(0) @map("predictions_made")
  predictions_resolved Int      @default(0) @map("predictions_resolved")
  // Lifetime hits (score >= 50). Stored denormalized so the resolver
  // doesn't have to COUNT(*) over prediction_results on every write;
  // hit_rate_pct stays consistent with hits/predictions_resolved with
  // no float drift. Maintained by data-pipeline's resolve_predictions
  // job (M33b).
  hits                 Int      @default(0) @map("hits")
  // Lifetime hits / lifetime resolved as a percentage; "hit" = score >= 50.
  hit_rate_pct         Float    @default(0) @map("hit_rate_pct")
  current_streak       Int      @default(0) @map("current_streak")
  best_streak          Int      @default(0) @map("best_streak")
  updated_at           DateTime @updatedAt @map("updated_at")

  @@index([total_points(sort: Desc)])
  @@map("user_scores")
}

/// @deprecated M36 — community suggestion flow retired with /community
/// hub archive. May resurface as "Vision contribution" PRs (M41+ admin
/// approval flow) but with a different schema.
model SectorSuggestion {
  // Community-submitted suggestion to improve a sector's structure —
  // e.g. "add NVDA as a memory-semi equity", "remove driver X because
  // it never moves". Editorial team reviews; an admin can flip status.
  id          String   @id @default(cuid())
  user_id     String   @map("user_id")
  user        User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  sector_slug String   @map("sector_slug")
  // "add_driver" | "remove_driver" | "add_equity" | "remove_equity" |
  // "rename_node" | "rewire_edge" — kept as a free string so new kinds
  // don't need a migration. The payload JSONB carries kind-specific
  // detail (e.g. {"ticker": "NVDA", "rationale": "..."}).
  kind        String
  title       String
  body        String?
  payload     Json     @default("{}")
  // "open" | "under_review" | "approved" | "rejected" | "withdrawn"
  status      String   @default("open")
  // Snapshot of net votes (`+1` ups - `-1` downs). Updated transactionally
  // with each vote insert/update so the list query stays cheap.
  score       Int      @default(0)
  created_at  DateTime @default(now()) @map("created_at")
  updated_at  DateTime @updatedAt @map("updated_at")

  votes SectorSuggestionVote[]

  @@index([sector_slug, status, score(sort: Desc)])
  @@index([user_id, created_at(sort: Desc)])
  @@map("sector_suggestions")
}

/// @deprecated M36 — see SectorSuggestion.
model SectorSuggestionVote {
  // One vote per (user, suggestion). Value is +1 or -1.
  suggestion_id String           @map("suggestion_id")
  suggestion    SectorSuggestion @relation(fields: [suggestion_id], references: [id], onDelete: Cascade)
  user_id       String           @map("user_id")
  user          User             @relation(fields: [user_id], references: [id], onDelete: Cascade)
  value         Int // +1 | -1
  created_at    DateTime         @default(now()) @map("created_at")

  @@id([suggestion_id, user_id])
  @@index([user_id, created_at(sort: Desc)])
  @@map("sector_suggestion_votes")
}

// =====================================================================
// M36 — Vision Feasibility Monitor
//
// Pivot from sector simulation toward a feasibility monitor for bold
// technology visions (e.g. "Will commercial fusion reach grid parity by
// 2040?"). See docs/PIVOT.md for product framing, docs/REFACTOR.md for
// the file-by-file refactor inventory.
//
// Core abstraction:
//   Vision (Sector row + is_vision_eligible)
//    └─ Capability (key tech / economic / regulatory / supply requirement)
//        ├─ 4-dimension readiness score (CapabilityScore time series)
//        ├─ Dependencies (CapabilityDependency DAG)
//        └─ Signals (paper / patent / news / filing → per-dim deltas)
//   Risk (orthogonal blockers — political, legal, supply, safety, ...)
//   VisionFeasibility (snapshot of vision-level composite + ETA)
//
// Internationalization: name/description/rationale fields are English
// only in M36. _ko variants land in a later slice (M37 or M38) once we
// settle on column-per-locale vs JSON-blob i18n.
// =====================================================================

model Capability {
  // A single capability required for a vision to be realized — e.g.
  // "Radiation-hard compute" within the Space Data Centers vision.
  //
  // Identified by a stable `key` (slug-like) per sector, used by signal
  // keyword maps, dependency edges, and admin URLs. The cuid id is the
  // opaque DB PK; UI code addresses capabilities by (sector_slug, key).

  id          String @id @default(cuid())
  sector_slug String @map("sector_slug")
  sector      Sector @relation(fields: [sector_slug], references: [slug], onDelete: Cascade)

  key         String // "rad_hard_compute"
  name        String // "Radiation-hard compute"
  short_name  String? @map("short_name") // "Rad-hard compute"
  description String // 1-2 sentences
  rationale   String // why this is necessary for the vision

  // Lower = more central / more blocking. Drives the "sort by
  // binding-ness" default order on the hero. Ties broken by
  // (composite_score asc, weight desc).
  display_order Int @default(100) @map("display_order")

  // Vision-aggregation weight (0.0 – 1.0). The vision_aggregator
  // (simulation-service feasibility module, M40) normalizes per-vision
  // before combining — so values don't have to sum to 1.0 across all
  // capabilities, but should be roughly proportional to importance.
  weight Float @default(0.1)

  // Optional pointer to a SimulationBase.driver so the Playground tab
  // can flag "moving this slider primarily affects [Capability X]" and
  // wire the what-if-feasibility projection (M42).
  primary_driver_name String? @map("primary_driver_name")

  // M41 — Agent-generated keyword set for the signal ingest pipeline.
  // For curated reference visions (SDC / memory-semi / sofc) the
  // canonical keyword list lives in
  // services/data-pipeline/data_pipeline/signals/keywords/<slug>.json
  // (admin-edited file). For agent-built visions (M41 Vision Builder)
  // the keywords are written here at vision creation time, so the
  // signal ingest job needs no filesystem write. Ingest reads JSON
  // file first (override), then falls back to this column.
  signal_keywords String[] @default([]) @map("signal_keywords")

  created_at DateTime @default(now()) @map("created_at")
  updated_at DateTime @updatedAt @map("updated_at")

  scores            CapabilityScore[]
  signals           Signal[]
  dependencies      CapabilityDependency[] @relation("CapabilitySource")
  dependents        CapabilityDependency[] @relation("CapabilityTarget")
  // M45: per-capability actor wiring with role (lead / competitor /
  // supplier / customer / regulator). Surfaces as "Active actors:" on
  // the capability card footer.
  capability_actors CapabilityActor[]

  @@unique([sector_slug, key])
  @@index([sector_slug])
  @@index([sector_slug, display_order])
  @@map("capabilities")
}

model CapabilityScore {
  // Time-series of (capability × 4-dimension) scores. Each row is a
  // snapshot at `as_of`; the most recent one per capability carries
  // is_current=true. The Score Updater agent (M40) writes new rows on
  // signal arrival; recompute_feasibility cron also writes daily.
  //
  // Score dimensions are independent, each ∈ [0, 100]:
  //   technical   — TRL-like: 100 = mass-deployable today
  //   economic    — unit economics + scale viability
  //   regulatory  — political / legal / export-control clearance
  //   supply      — supply chain / talent / capital bottlenecks
  // Null = "not yet assessed".
  //
  // `composite` is computed by simulation-service's aggregator: a
  // weighted mean of the 4 dims, optionally capped by the binding
  // constraint (lowest dim) when binding-constraint logic is enabled
  // per-capability.

  id            String     @id @default(cuid())
  capability_id String     @map("capability_id")
  capability    Capability @relation(fields: [capability_id], references: [id], onDelete: Cascade)

  technical  Float?
  economic   Float?
  regulatory Float?
  supply     Float?

  composite     Float?
  // P10–P90 band around the composite — surfaces "we don't know yet"
  // honestly on the hero gauge.
  composite_p10 Float? @map("composite_p10")
  composite_p90 Float? @map("composite_p90")

  as_of      DateTime
  is_current Boolean  @default(false) @map("is_current")

  // Agent- or admin-written explanation of what moved since the prior
  // snapshot — surfaces in the capability detail page time-series.
  rationale String?

  created_at DateTime @default(now()) @map("created_at")

  @@index([capability_id, as_of(sort: Desc)])
  @@index([capability_id, is_current])
  @@map("capability_scores")
}

model CapabilityDependency {
  // DAG between capabilities — "source depends on target." E.g.
  // "in_orbit_thermal_rejection" might depend on
  // "high_efficiency_radiator_materials". Used by the Capability detail
  // page's mini dep-graph drill-down (M38) and by the vision aggregator
  // (M40) when propagating binding-constraint effects.
  //
  // Cycles are forbidden — enforced at the tRPC mutation layer (M36)
  // since Prisma can't express graph constraints declaratively.

  id        String     @id @default(cuid())
  source_id String     @map("source_id")
  target_id String     @map("target_id")
  source    Capability @relation("CapabilitySource", fields: [source_id], references: [id], onDelete: Cascade)
  target    Capability @relation("CapabilityTarget", fields: [target_id], references: [id], onDelete: Cascade)
  rationale String?

  created_at DateTime @default(now()) @map("created_at")

  @@unique([source_id, target_id])
  @@index([target_id])
  @@map("capability_dependencies")
}

model Signal {
  // A source-grounded event that contributes to one or more capability
  // scores. Ingested by the signal pipeline (M39 — arXiv, USPTO,
  // NewsAPI, govt feeds) and scored by the Signal Extractor agent
  // (haiku tier) into per-dimension deltas.
  //
  // capability_id is single-valued in M36; multi-capability mapping
  // (one paper moving 2+ capabilities) lands as a join table in a
  // later slice if needed. For now, when a signal moves multiple
  // capabilities the ingest pipeline writes one Signal row per
  // (signal, capability) pair, keyed by (source_url, capability_id).

  id          String @id @default(cuid())
  sector_slug String @map("sector_slug")
  sector      Sector @relation(fields: [sector_slug], references: [slug], onDelete: Cascade)

  capability_id String?     @map("capability_id")
  capability    Capability? @relation(fields: [capability_id], references: [id], onDelete: SetNull)

  // M45b: actor mention extracted by the SignalExtractor agent
  // (M39+M45b). Single-actor for v1 — multi-actor mentions would write
  // duplicate Signal rows under the same source_url, similar to how
  // multi-capability mentions are handled. Set to actor_id only when
  // extractor confidence > 0.8; null otherwise.
  actor_id String? @map("actor_id")
  actor    Actor?  @relation(fields: [actor_id], references: [id], onDelete: SetNull)

  // Taxonomy: paper / patent / news / filing / gov_report / vendor_doc
  // / dataset / social. Re-uses the kind taxonomy already established
  // on Source / Provenance in the SDK.
  source_kind   String  @map("source_kind")
  source_url    String  @map("source_url")
  // arXiv id (2401.12345), USPTO patent number, DOI, etc. — null when
  // the source has no stable external id.
  source_id_ext String? @map("source_id_ext")

  title        String
  summary      String?
  published_at DateTime @map("published_at")

  // Per-dimension deltas, signed (-10 .. +10). Set by the extractor
  // agent; null = not yet scored. The score updater (M40) reads these
  // when recomputing capability composite.
  delta_technical  Float? @map("delta_technical")
  delta_economic   Float? @map("delta_economic")
  delta_regulatory Float? @map("delta_regulatory")
  delta_supply     Float? @map("delta_supply")

  // Promoted to the hero "Live Signals" panel when true. Set by the
  // extractor when the magnitude warrants attention.
  is_highlight Boolean @default(false) @map("is_highlight")

  ingested_at DateTime @default(now()) @map("ingested_at")

  @@unique([source_url, capability_id])
  @@index([sector_slug, published_at(sort: Desc)])
  @@index([capability_id, published_at(sort: Desc)])
  @@index([actor_id, published_at(sort: Desc)])
  @@index([sector_slug, is_highlight, published_at(sort: Desc)])
  @@map("signals")
}

model Risk {
  // Risks are orthogonal to capabilities — political, legal, supply,
  // safety, environmental, financial, social factors that could
  // derail a vision independent of any single capability's readiness.
  //
  // Rendered on the hero Risk Board: ●/○ severity dot + category +
  // description + linked capabilities. Severity × likelihood matrix
  // on the Risks detail tab (M38).
  //
  // affected_capability_keys is a Postgres text[]; each entry is a
  // Capability.key in the same sector. Not a FK because the keys live
  // on a sibling table — keeping it denormalized to a string array
  // makes the hero render cheap. Integrity is enforced at the tRPC
  // mutation layer.

  id          String @id @default(cuid())
  sector_slug String @map("sector_slug")
  sector      Sector @relation(fields: [sector_slug], references: [slug], onDelete: Cascade)

  key         String
  category    String // political | legal | supply | safety | environmental | financial | social
  name        String
  description String

  severity     String // low | medium | high | critical
  likelihood   String // low | medium | high
  // Time horizon over which the risk plausibly materializes:
  // immediate | 1y | 3y | 5y | 10y. Free string so we can extend.
  time_horizon String  @map("time_horizon")
  mitigations  String?

  affected_capability_keys String[] @map("affected_capability_keys")

  // MP4 — source attribution. Lets the Risk Board attach a clickable
  // SourceChip to every risk so the user can drill from "this risk
  // exists" to "here is the regulatory filing / accident report / news
  // article that says so". All three are nullable for backward compat;
  // when present, source_url is the canonical link, source_kind drives
  // the chip's colour (paper / news / filing / gov_report / ...),
  // source_title is the optional hover-popover headline.
  source_url   String? @map("source_url")
  source_kind  String? @map("source_kind")
  source_title String? @map("source_title")

  display_order Int @default(100) @map("display_order")

  created_at DateTime @default(now()) @map("created_at")
  updated_at DateTime @updatedAt @map("updated_at")

  @@unique([sector_slug, key])
  @@index([sector_slug])
  @@index([sector_slug, severity])
  @@map("risks")
}

model VisionFeasibility {
  // Vision-level composite snapshot. Computed by the simulation-service
  // vision_aggregator (M40) by Bayesian aggregation of capability
  // composites with Liebig's-law binding-constraint logic (vision
  // composite is capped by the lowest weighted capability — softened
  // by a configurable factor so a single dim doesn't fully dominate).
  //
  // Time series; the most recent snapshot per sector carries
  // is_current=true. Hero's trajectory + ETA window read this table.

  id          String @id @default(cuid())
  sector_slug String @map("sector_slug")
  sector      Sector @relation(fields: [sector_slug], references: [slug], onDelete: Cascade)

  as_of      DateTime
  is_current Boolean  @default(false) @map("is_current")

  composite     Float
  composite_p10 Float? @map("composite_p10")
  composite_p90 Float? @map("composite_p90")

  // The capability driving the cap (lowest composite × weight). Used
  // to surface "BINDING" badge on the hero capability cards.
  binding_capability_key String? @map("binding_capability_key")

  // ETA: years-from-as_of until the vision crosses a configurable
  // feasibility threshold (default 80). Linear extrapolation from
  // recent trajectory in M40 v1; logistic-fit upgrade later.
  eta_median_years Float? @map("eta_median_years")
  eta_p10_years    Float? @map("eta_p10_years")
  eta_p90_years    Float? @map("eta_p90_years")

  // Hero "▲ +8 (90d)" delta. Pre-computed at snapshot time so the
  // hero query stays O(1) per vision.
  delta_90d Float? @map("delta_90d")

  rationale String?

  created_at DateTime @default(now()) @map("created_at")

  @@index([sector_slug, as_of(sort: Desc)])
  @@index([sector_slug, is_current])
  @@map("vision_feasibility")
}

// =====================================================================
// M45 — Actor domain
//
// The "WHO" layer of the Vision Feasibility Monitor. An Actor is a
// global real-world entity (public corp / private startup / govt lab /
// national lab / academic lab / standards body) that builds or
// influences technology capabilities. Same Actor can affect multiple
// Visions (e.g. Samsung shows up in both memory-semi and SoFC).
//
// Why a fresh model, not equity repurpose:
//   - SectorEquity.driver_links JSONB is investment-frame, not
//     capability-frame
//   - sector_exposure_pct measures revenue share, not relevance
//   - Labs / govt / standards bodies don't have tickers — equity model
//     forces it as required
//
// See docs/PIVOT.md §5.1 + §11.5 for the rationale.
// =====================================================================

model Actor {
  id String @id @default(cuid())

  // Stable global key — e.g. "spacex" or "kr_kaist". Lowercase
  // snake_case. UNIQUE — the same Actor can't exist twice; M2M wiring
  // through VisionActor + CapabilityActor.
  key String @unique

  name       String // "SpaceX" / "Samsung Electronics"
  short_name String? @map("short_name") // "SpaceX" / "Samsung"
  // Native-script name (Korean, Japanese, etc.) for non-English actors
  name_local String? @map("name_local") // "삼성전자"

  iso_country String @map("iso_country") // ISO 3166-1 alpha-2 — "US" / "KR" / "DE"

  // Drives badge color + filtering on the Actors page
  category String // "public_corp" | "private_startup" | "government_lab" | "national_lab" | "academic_lab" | "standards_body" | "ngo"

  // Listing info — set when the actor is publicly traded. Not
  // investment advice; just lets users drill into financials externally.
  ticker   String?
  exchange String? // "NYSE" / "NASDAQ" / "KOSPI" / "TSE" / ...

  // One-line tagline for the actor card
  blurb String

  // Longer description (admin-curated; agent-generated in M41+)
  description String?

  // Stage of involvement — drives the "actor maturity" pill on cards.
  // Default for the actor as a whole; CapabilityActor.stage can override
  // per-capability ("scaling overall, research on quantum specifically").
  stage String // "research" | "pilot" | "commercial" | "scaling"

  // Optional links — admin curates, we don't host these
  logo_url String? @map("logo_url")
  website  String?

  // Keywords for the SignalExtractor agent (M39+M45b). Name aliases,
  // product lines, exec names. The extractor matches signal titles +
  // summaries against these per-vision before setting Signal.actor_id.
  signal_keywords String[] @default([]) @map("signal_keywords")

  created_at DateTime @default(now()) @map("created_at")
  updated_at DateTime @updatedAt @map("updated_at")

  vision_actors     VisionActor[]
  capability_actors CapabilityActor[]
  signals           Signal[]

  @@index([category])
  @@index([iso_country])
  @@map("actors")
}

model VisionActor {
  // Many-to-many join: a single Actor can affect multiple Visions; a
  // Vision has dozens of Actors. Join carries vision-specific context
  // — relevance (per-vision how central this actor is), rationale
  // (why), display_order (admin spotlight sort).

  id          String @id @default(cuid())
  actor_id    String @map("actor_id")
  actor       Actor  @relation(fields: [actor_id], references: [id], onDelete: Cascade)
  sector_slug String @map("sector_slug")
  sector      Sector @relation(fields: [sector_slug], references: [slug], onDelete: Cascade)

  // 0-100 — how central this Actor is to the Vision. Used for Hero
  // "top actors" sort. Null = not yet rated.
  relevance Float?

  // Per-vision rationale ("Starship is the cheap-launch story —
  // primary catalyst for orbital DC economics")
  rationale String?

  display_order Int @default(100) @map("display_order")

  created_at DateTime @default(now()) @map("created_at")
  updated_at DateTime @updatedAt @map("updated_at")

  @@unique([actor_id, sector_slug])
  @@index([sector_slug])
  @@index([sector_slug, relevance(sort: Desc)])
  @@map("vision_actors")
}

model CapabilityActor {
  // Per-capability actor mapping — which actors are advancing which
  // capability. Lets the hero show "In-orbit thermal: Starcloud + ESA +
  // JPL" on the capability card footer.

  id            String     @id @default(cuid())
  capability_id String     @map("capability_id")
  capability    Capability @relation(fields: [capability_id], references: [id], onDelete: Cascade)
  actor_id      String     @map("actor_id")
  actor         Actor      @relation(fields: [actor_id], references: [id], onDelete: Cascade)

  // Role this actor plays for this specific capability:
  //   lead       — primary developer / consortium lead
  //   competitor — alternative approach pursuing same outcome
  //   supplier   — provides upstream inputs (e.g. TSMC for rad-hard chips)
  //   customer   — buys the capability when ready
  //   regulator  — sets rules / approvals (e.g. ITU for spectrum)
  role String @default("competitor")

  // Optional override of Actor.stage for this specific capability
  stage     String?
  rationale String?

  created_at DateTime @default(now()) @map("created_at")
  updated_at DateTime @updatedAt @map("updated_at")

  @@unique([capability_id, actor_id])
  @@index([capability_id])
  @@index([capability_id, role])
  @@map("capability_actors")
}

// =====================================================================
// M46a — Community 3.0: Proposals
//
// Users (Member tier and above) propose enrichments to any element of a
// vision / sector: a new driver, a new equity, a new capability / risk /
// actor, a new signal source, or freeform improvement notes. Each
// proposal carries multi-source evidence (URL with OG preview, uploaded
// PDF/image, or freeform text) and accumulates upvotes from the
// community. Admins (and high-rep users in M46c+) move it through the
// status pipeline; on acceptance, the structured `proposed_payload`
// drives the target-kind-specific DB write (handled in M46e).
// =====================================================================

model CommunityProposal {
  id String @id @default(cuid())

  // Author. Must be a registered user — proposals are not anonymous.
  author_id String @map("author_id")
  author    User   @relation("ProposalAuthor", fields: [author_id], references: [id], onDelete: Cascade)

  // Sector / Vision this proposal targets. Required — proposals are
  // always scoped to a sector. Cross-sector "platform" proposals are
  // out of scope for v1.
  sector_slug String @map("sector_slug")

  // What kind of element is being proposed. The full set the M46e
  // applier handles:
  //   add_driver       — new SimulationBase driver
  //   add_equity       — new SectorEquity row
  //   add_capability   — new Capability + initial CapabilityScore
  //   add_risk         — new Risk row
  //   add_actor        — new Actor + VisionActor + CapabilityActor wiring
  //   add_signal_source — new keyword set / source URL for ingest
  //   edit             — edit an existing row (target_ref points to it)
  //   other            — freeform; never auto-applies
  target_kind String @map("target_kind")

  // When the proposal is editing an existing row, this is its key/slug;
  // null for fresh "add_*" proposals.
  target_ref String? @map("target_ref")

  title String
  body  String

  // The exact payload that gets fed to the M46e applier on acceptance.
  // Shape depends on `target_kind`:
  //   add_driver: { name, group, unit, default, min, max, description }
  //   add_capability: { key, name, description, weight, ... }
  //   ...
  // Pydantic / Zod schemas in the applier validate this before DB write.
  // Stored as Json so each kind can evolve without a schema migration.
  proposed_payload Json @map("proposed_payload")

  // Pipeline status. Drives admin queue + filtering. Transitions are
  // logged via AuditLog.
  //   open      — accepting votes
  //   review    — admin (or high-rep auto-promotion in M46e) is looking
  //   applied   — DB write succeeded; decided_at + decided_by set
  //   rejected  — admin chose not to pursue; reason in audit_log
  //   stale     — auto-aged out after 90d with no decision + low votes
  status String @default("open")

  // Denormalized for cheap sort/feed queries. Recomputed on each vote
  // insert/delete (the vote handler writes both rows in a transaction).
  vote_score Int @default(0) @map("vote_score")

  // Decision metadata. Set when status transitions to applied/rejected.
  decided_at      DateTime? @map("decided_at")
  decided_by_id   String?   @map("decided_by_id")
  decided_by      User?     @relation("ProposalDecidedBy", fields: [decided_by_id], references: [id], onDelete: SetNull)
  decision_reason String?   @map("decision_reason")

  created_at DateTime @default(now()) @map("created_at")
  updated_at DateTime @updatedAt @map("updated_at")

  evidence ProposalEvidence[]
  votes    ProposalVote[]
  replies  ProposalReply[]

  // Hot feed: sector + status + score desc
  @@index([sector_slug, status, vote_score(sort: Desc)])
  // New feed: sector + created_at desc
  @@index([sector_slug, created_at(sort: Desc)])
  // Global hot/new + author profile
  @@index([status, vote_score(sort: Desc)])
  @@index([author_id, created_at(sort: Desc)])
  // Admin queue ordering
  @@index([status, created_at(sort: Desc)])
  @@map("community_proposals")
}

model ProposalEvidence {
  // Each piece of evidence attached to a proposal — URL, uploaded
  // PDF/image, or freeform text. Order matters (admin / readers see
  // evidence in the same order the author arranged).
  //
  // For url kind: `content` is the URL; `fetched_meta` carries the
  // M46d OG-fetcher's output (title, description, screenshot_url).
  // For pdf / image kind: `content` is the R2 object key.
  // For text kind: `content` IS the body (markdown allowed); fetched_meta
  // stays null.

  id          String @id @default(cuid())
  proposal_id String @map("proposal_id")
  proposal    CommunityProposal @relation(fields: [proposal_id], references: [id], onDelete: Cascade)

  kind        String  // url | pdf | image | text
  content     String  // URL / R2 key / freeform body
  fetched_meta Json?  @map("fetched_meta")
  // Display order chosen by the author.
  order_index Int     @default(0) @map("order_index")

  created_at DateTime @default(now()) @map("created_at")

  @@index([proposal_id, order_index])
  @@map("proposal_evidence")
}

model ProposalVote {
  // Upvote-only (no downvote — see plan §8). One vote per (user, proposal).
  // `weight` is the vote's contribution to the proposal's vote_score —
  // 1 for newcomers, scales with voter reputation in M46c (Stack Overflow
  // pattern: the system trusts high-rep voters more). M46a writes 1
  // unconditionally; M46c upgrades the writer.

  proposal_id String @map("proposal_id")
  user_id     String @map("user_id")
  proposal    CommunityProposal @relation(fields: [proposal_id], references: [id], onDelete: Cascade)
  user        User              @relation(fields: [user_id], references: [id], onDelete: Cascade)

  weight     Int      @default(1)
  created_at DateTime @default(now()) @map("created_at")

  @@id([proposal_id, user_id])
  @@index([user_id, created_at(sort: Desc)])
  @@map("proposal_votes")
}

model ProposalReply {
  // Threaded reply. Single-level nesting (parent_reply_id) to keep
  // rendering simple — no deep tree. Reply upvotes don't exist in
  // M46a (only proposal-level votes; see plan §8 anti-features).

  id              String @id @default(cuid())
  proposal_id     String @map("proposal_id")
  parent_reply_id String? @map("parent_reply_id")
  author_id       String @map("author_id")

  proposal CommunityProposal @relation(fields: [proposal_id], references: [id], onDelete: Cascade)
  author   User              @relation(fields: [author_id], references: [id], onDelete: Cascade)
  parent   ProposalReply?    @relation("ReplyParent", fields: [parent_reply_id], references: [id], onDelete: Cascade)
  children ProposalReply[]   @relation("ReplyParent")

  body       String
  created_at DateTime @default(now()) @map("created_at")
  updated_at DateTime @updatedAt @map("updated_at")

  @@index([proposal_id, created_at])
  @@index([parent_reply_id])
  @@map("proposal_replies")
}

// =====================================================================
// M46b — Community 3.0: PredictionV2
//
// Per-equity price-band predictions with auto-assigned difficulty
// tiers. Replaces the legacy `predictions` table conceptually (kept in
// place; legacy UI moves behind ENABLE_LEGACY_INVESTMENT_FEATURES at
// M43). The tier (easy/medium/hard) is derived from (horizon,
// annualized_vol, spread_pct) by the placer; reward is computed at
// resolution time as `score × tier_multiplier × 10` where:
//   easy   → 1×   max  10p
//   medium → 2.5× max  25p
//   hard   → 5×   max  50p
//
// Score is 1.0 inside the band, decays linearly to 0 at distance
// = spread outside the band, clamped to [0, 1]. So a tight band with
// the actual price 0.5×spread outside → 0.5 points; 1.0×spread
// outside → 0 points.
//
// Resolution: the M46b data-pipeline cron runs hourly, picks up
// predictions whose resolves_at has passed, finds the next available
// EquityQuote close, computes score + reward, writes resolved_at.
// =====================================================================

model PredictionV2 {
  id String @id @default(cuid())

  user_id String @map("user_id")
  user    User   @relation("UserPredictionsV2", fields: [user_id], references: [id], onDelete: Cascade)

  // We tie predictions to SectorEquity rows so we get the
  // pre-curated ticker + exchange + sector_slug for free. Cross-
  // sector predictions on the same ticker create separate rows.
  equity_id String       @map("equity_id")
  equity    SectorEquity @relation(fields: [equity_id], references: [id], onDelete: Cascade)

  // Time horizon. Drives `resolves_at` and the tier rules.
  //   1d — single trading day (always Hard)
  //   1w — one week
  //   1m — one month
  horizon String

  // The prediction band. Actual close at resolution time within
  // [min, max] = full score; outside, linear decay (see comment above).
  expected_price_min Float @map("expected_price_min")
  expected_price_max Float @map("expected_price_max")

  // Snapshot of the anchor close at placement time. Used by the
  // detail page to render "from X to your band". Also lets us
  // audit-trail what the placer was looking at.
  anchor_price Float    @map("anchor_price")
  anchor_date  DateTime @map("anchor_date")

  // Auto-assigned by `lib/prediction-tier.ts`. NOT a free field —
  // server recomputes on placement to prevent client-side spoofing.
  // `tier_explanation` is the human-readable "why" surfaced as a
  // tooltip next to the badge.
  tier             String
  tier_explanation String? @map("tier_explanation")

  placed_at   DateTime  @default(now()) @map("placed_at")
  resolves_at DateTime  @map("resolves_at")
  resolved_at DateTime? @map("resolved_at")

  actual_price  Float? @map("actual_price")
  // 0..1; see comment block above.
  score         Float?
  // Final integer points awarded. Null until resolved.
  reward_points Int?   @map("reward_points")

  // open | resolved (cron sets `resolved` after writing score +
  // reward_points). No "cancelled" — once placed, it resolves.
  status String @default("open")

  // Optional plain-text rationale. Markdown rendering is a v2 polish.
  rationale String?

  created_at DateTime @default(now()) @map("created_at")
  updated_at DateTime @updatedAt @map("updated_at")

  @@index([user_id, placed_at(sort: Desc)])
  // Resolution cron: WHERE status='open' AND resolves_at <= now()
  @@index([status, resolves_at])
  // Equity-level live + resolved feed
  @@index([equity_id, placed_at(sort: Desc)])
  // Leaderboard helper (status='resolved' GROUP BY user_id SUM reward_points)
  @@index([status, reward_points(sort: Desc)])
  @@map("predictions_v2")
}

// =====================================================================
// M46c — Community 3.0: Reputation + Follow
//
// `UserReputation` is the denormalized leaderboard surface. Source of
// truth is the `PointEvent` log (every point in/out is recorded as an
// immutable event). UserReputation.total_points should equal
// `SUM(point_events.amount) WHERE user_id = X` — every write site
// updates both atomically.
//
// Tier is derived from total_points by tierFromPoints() in
// services/sector-service/src/lib/reputation.ts (single source of
// truth). Persisted on UserReputation so leaderboard queries don't
// need to recompute.
//
// `UserFollow` is one-way (Twitter-style). Mutual follow = two rows.
// =====================================================================

model UserReputation {
  user_id      String   @id @map("user_id")
  user         User     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  // Sum of all PointEvent.amount rows for this user. Can dip
  // (proposal vote un-toggled subtracts; we don't floor here so the
  // log is honest. The tier function clamps to "newcomer" on
  // negative values).
  total_points Int      @default(0) @map("total_points")
  // newcomer | member | analyst | senior | maintainer
  tier         String   @default("newcomer")

  updated_at   DateTime @updatedAt @map("updated_at")

  // Leaderboard primary index
  @@index([total_points(sort: Desc)])
  @@map("user_reputation")
}

model PointEvent {
  // Immutable ledger row. Each grant or revocation of reputation
  // points writes one row. Source of truth — `UserReputation.total_
  // points` is a denormalized sum of these.

  id      String @id @default(cuid())
  user_id String @map("user_id")
  user    User   @relation(fields: [user_id], references: [id], onDelete: Cascade)

  // kind taxonomy:
  //   prediction_resolved   — reward_points awarded at resolution
  //   proposal_vote_received — author got an upvote (positive amount;
  //                            negative when the voter toggles off)
  //   proposal_applied      — admin shipped the author's proposal
  //   reply_upvote          — reply landed an upvote (M47 only;
  //                            unused in M46c)
  //   manual_grant          — admin discretionary grant / clawback
  kind   String

  // Signed integer — can be negative for revocations (e.g. vote
  // toggle-off). Sum stays non-negative under normal operation.
  amount Int

  // Optional pointer to the source event. For prediction_resolved
  // this is the PredictionV2.id; for proposal_vote_received it's
  // the proposal_id. Free-form text — joins are admin-only so
  // keeping it relaxed avoids FK churn when tables drift.
  refers_to_kind String? @map("refers_to_kind")
  refers_to_id   String? @map("refers_to_id")

  created_at DateTime @default(now()) @map("created_at")

  @@index([user_id, created_at(sort: Desc)])
  @@index([kind, created_at(sort: Desc)])
  @@map("point_events")
}

model UserFollow {
  // One-way follow relationship. (follower_id, followed_id) is the
  // composite PK so re-following is a no-op rather than duplicate.

  follower_id String   @map("follower_id")
  followed_id String   @map("followed_id")
  follower    User     @relation("FollowsOut", fields: [follower_id], references: [id], onDelete: Cascade)
  followed    User     @relation("FollowsIn",  fields: [followed_id], references: [id], onDelete: Cascade)

  created_at  DateTime @default(now()) @map("created_at")

  @@id([follower_id, followed_id])
  // Profile shows "followers of X" + "X follows N people"
  @@index([followed_id, created_at(sort: Desc)])
  @@index([follower_id, created_at(sort: Desc)])
  @@map("user_follows")
}

/// M48a — one row per crawler fetch. The admin cockpit reads this
/// table to render the live-jobs pane + 24h health pane. Writes come
/// exclusively from `services/crawler/`.
///
/// `vision_slug` mirrors the slug-as-string pattern already used by
/// `CommunityProposal.sector_slug` — no FK to Sector, so cross-vision
/// or orphaned smoke runs don't break the table. `cost_usd` is null
/// for runs that never reached the LLM (e.g. cache hits, dry-run
/// plans). `result_summary` shape is fetcher-specific JSON, validated
/// by the fetcher's own Pydantic schema before write.
model CrawlRun {
  id           String @id @default(cuid())

  vision_slug  String @map("vision_slug")

  // "capability" | "actor" | "signal" | "risk" | "economics" |
  // "deep_research" | "hello_world" (M48c smoke). Free-form string so
  // a new fetcher kind doesn't require a schema migration.
  fetcher_kind String @map("fetcher_kind")

  // "queued" | "running" | "ok" | "error" | "cancelled"
  status       String @default("queued")

  // FetchPlan as JSON — the prompt or query the fetcher will issue.
  // Kept verbatim so a re-run from the cockpit is reproducible.
  plan         Json

  // WriteSummary as JSON — fetcher-specific result shape. Null until
  // status transitions to ok/error.
  result_summary Json? @map("result_summary")

  // Metered LLM spend for this run. Null when no LLM call was made
  // (cache hit, dry-run, or pre-LLM failure).
  cost_usd          Decimal? @map("cost_usd") @db.Decimal(10, 4)
  signals_written   Int      @default(0) @map("signals_written")
  proposals_written Int      @default(0) @map("proposals_written")

  // Short, single-line. Full stack traces go to logs, not the table.
  error      String?

  started_at DateTime  @default(now()) @map("started_at")
  ended_at   DateTime? @map("ended_at")

  // Cockpit "recent runs for this vision" (default sort).
  @@index([vision_slug, started_at(sort: Desc)])
  // Cockpit "all runs of kind X" filter + "Capability fetcher health" query.
  @@index([fetcher_kind, started_at(sort: Desc)])
  // Live-jobs pane — `WHERE status IN ('queued','running')`.
  @@index([status, started_at(sort: Desc)])

  @@map("crawl_runs")
}
